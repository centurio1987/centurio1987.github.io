.eslintcache
.cache
*.tsbuildinfo
.vitepress/cache

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# manage-kanban 다중 세션 잠금(로컬 전용)
KANBAN.state.json.lock
KANBAN.cards/.*.lock
