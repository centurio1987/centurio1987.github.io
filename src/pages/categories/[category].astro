---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import FeedLink from "../../components/FeedLink.astro";
import { CATEGORIES, getCategory } from "../../lib/categories";
import { FEED_TITLE, categoryFeedUrl } from "../../lib/feed";
import { POSTS_URL } from "../../lib/urls";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return CATEGORIES.map((cat) => ({
    params: { category: cat.slug },
    props: {
      posts: posts
        .filter((p) => p.data.category === cat.slug)
        .sort(
          (a, b) =>
            b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
            b.id.localeCompare(a.id),
        ),
      category: cat.slug,
    },
  }));
}

const { posts, category } = Astro.props;
const meta = getCategory(category);
const feedUrl = categoryFeedUrl(category);
---

<BaseLayout
  title={`${meta.label} 글`}
  description={`${meta.label} 카테고리의 글 모음`}
  feeds={[{ href: feedUrl, title: `${FEED_TITLE} — ${meta.label}` }]}
>
  <section class="wrap">
    <p class="back"><a href={POSTS_URL} class="sketch-link">← 전체 글</a></p>
    <div class="head">
      <h1 style={`--cat:${meta.color}`}>
        <span class="swatch" aria-hidden="true"></span>{meta.label}
      </h1>
      <FeedLink href={feedUrl} label={`${meta.label} 글`} />
    </div>
    {
      posts.length > 0 ? (
        <PostList posts={posts} />
      ) : (
        <p class="empty">이 카테고리엔 아직 글이 없습니다.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-48) var(--page-pad) 0;
  }
  .back {
    font-size: var(--text-meta);
    margin: 0 0 var(--space-12);
  }
  /* 카테고리 제목과 그 카테고리 피드 구독 캡슐을 한 줄에 (KAN-047). */
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-10);
    margin: 0 0 var(--space-16);
  }
  h1 {
    display: flex;
    align-items: center;
    gap: var(--space-10);
    font-size: clamp(28px, 6vw, 38px);
    margin: 0;
  }
  .swatch {
    width: 18px;
    height: 18px;
    border-radius: var(--radius-round);
    background: var(--cat);
    border: var(--stroke) solid var(--ink);
  }
  .empty {
    color: var(--ink-2);
  }
</style>
