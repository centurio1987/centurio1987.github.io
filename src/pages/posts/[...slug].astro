---
import { getCollection, render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import TalkLayout from "../../layouts/TalkLayout.astro";
import ProseQuote from "../../components/deco/mdx/ProseQuote.astro";
import ProseCode from "../../components/deco/mdx/ProseCode.astro";
import DoodleMark from "../../components/deco/DoodleMark.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const isTalk = post.data.template === "talk";

/**
 * 마크다운이 만든 인용·코드블록에 데코 키트 패턴을 얹는다. 본문 파일을 안 고치고
 * 생김새만 바꾸는 유일한 접점이라 여기서 꽂는다.
 *
 * 폭신 대담(template: "talk")은 제외한다 — TalkLayout 은 자기 시각 언어(PullQuote·
 * QA)를 따로 갖고 있고, deco.css 를 들여오지 않아 데코 토큰이 아예 없다.
 *
 * **`Mark` 만은 대담에도 꽂는다.** 나머지 둘은 지면을 꾸미는 것이지만 두들 마크는
 * 이모지를 대신해 **문장 안에서 뜻을 지는** 기호라, 템플릿이 다르다고 빠지면 본문이
 * 틀린다. `DoodleMark` 는 색 토큰마다 시안 hex fallback 을 들고 있어 deco.css 없이도
 * 그려진다(그 부품 머리글). MDX 는 스코프에 없는 대문자 태그를 `components` 에서
 * 찾으므로, 글에 import 를 적지 않아도 `<Mark name="no" />` 로 쓸 수 있다.
 */
const decoComponents = isTalk
  ? { Mark: DoodleMark }
  : { blockquote: ProseQuote, pre: ProseCode, Mark: DoodleMark };
---

{
  /* 레이아웃을 변수로 고르지 않고 나눠 렌더한다 — TalkLayout 은 headings 를 쓰지 않는데
     공용 변수로 묶으려면 쓰지도 않을 prop 으로 타입만 넓혀야 한다(TalkLayout 은 자체
     "오늘의 질문" 목차를 갖는다). */
  isTalk ? (
    <TalkLayout post={post}>
      <Content components={decoComponents} />
    </TalkLayout>
  ) : (
    <PostLayout post={post} headings={headings}>
      <Content components={decoComponents} />
    </PostLayout>
  )
}
