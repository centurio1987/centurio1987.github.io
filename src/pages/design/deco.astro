---
/**
 * 데코 키트 쇼케이스 — /design/deco
 *
 * 부품 카탈로그와 적용 패턴을 **실제 컴포넌트로** 그린다. 문서(DECO_KIT.md)가 규칙을
 * 적는다면 이 페이지는 그 규칙이 지금도 도는지를 보여준다 — 부품을 고치면 여기가 같이
 * 바뀌고, 깨지면 빌드가 아니라 이 화면에서 먼저 티가 난다.
 *
 * 독자용 페이지가 아니라 noindex + 사이트맵 제외(astro.config.mjs).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import DecoLayer from "../../components/deco/DecoLayer.astro";
import Tape from "../../components/deco/Tape.astro";
import Sticker from "../../components/deco/Sticker.astro";
import Doodle from "../../components/deco/Doodle.astro";
import DoodleMark from "../../components/deco/DoodleMark.astro";
import Clip from "../../components/deco/Clip.astro";
import Twine from "../../components/deco/Twine.astro";
import Clothespin from "../../components/deco/Clothespin.astro";
import StickyNote from "../../components/deco/StickyNote.astro";
import IndexTab from "../../components/deco/IndexTab.astro";
import Polaroid from "../../components/deco/Polaroid.astro";
import CornerMount from "../../components/deco/CornerMount.astro";
import Stamp from "../../components/deco/Stamp.astro";
import TicketStub from "../../components/deco/TicketStub.astro";
import PaperSurface from "../../components/deco/PaperSurface.astro";
import HeroCollage from "../../components/deco/patterns/HeroCollage.astro";
import TapedBoard from "../../components/deco/patterns/TapedBoard.astro";
import ClippedCard from "../../components/deco/patterns/ClippedCard.astro";
import MarkedQuote from "../../components/deco/patterns/MarkedQuote.astro";
import MarkedCode from "../../components/deco/patterns/MarkedCode.astro";
import DecoHeading from "../../components/deco/patterns/DecoHeading.astro";
import PhotoFrame from "../../components/deco/patterns/PhotoFrame.astro";
import { DECO_INTENSITY, TONY_DIECUT } from "../../lib/deco";
import { DOODLE_MARKS, MARK_NAMES } from "../../lib/doodleMarks";
import {
  PHOTO_FRAMES,
  FRAME_CASES,
  VIZ_FRAME_LINEAGE,
  judgePhotoFrames,
  pickPhotoFrames,
  type FrameReject,
  type PhotoFrameVariant,
} from "../../lib/photoFrames";

/** 탈락 사유의 사람 말. 코드에는 축 이름만 있고 뜻은 여기서 편다. */
const REJECT_LABEL: Record<FrameReject, string> = {
  slots: "칸 수",
  orient: "비율",
  crops: "자름",
  occludes: "가림",
  noise: "시끄러움",
  surface: "자리",
  repeat: "반복",
};
import "../../styles/deco.css";

/**
 * 액자 칸의 시연값 — 부품이 아니라 **이 칸의 예시**다(W1·W3 칸과 같은 판단).
 * 폭은 시안 값이 아니라 272px 칸 안에 얹은 것까지 들어가게 죈 값이다: 테이프·도장·
 * 말풍선이 액자 밖으로 14~58px 나가므로, 시안 폭(172~200)을 그대로 두면 칸을 넘는다.
 */
const PF_DEMO: Record<
  PhotoFrameVariant,
  { width: number; caption?: string; label?: string; note?: string }
> = {
  "polaroid-tape": { width: 150, caption: "그날의 빵" },
  /* 테이프 넷이 코너를 물려면 사진이 테이프보다 충분히 커야 한다 — 150 에서는
     66px 테이프 넷이 사진보다 커 보여 "문 것"이 아니라 "덮은 것"으로 읽힌다. */
  "taped-corners": { width: 168 },
  scrapbook: { width: 156 },
  film: { width: 152 },
  pegged: { width: 152 },
  kraft: { width: 148, caption: "찢어 붙인 조각" },
  crayon: { width: 152 },
  diecut: { width: 140 },
  instax: { width: 128, caption: "07.28 SEOUL", label: "2026" },
  collage: { width: 112 },
  vellum: { width: 150, caption: "오늘의 기록", note: "좋다!" },
  stamped: { width: 140, label: "2026.07.28" },
};
---

<BaseLayout title="데코 키트" description="다이어리 데코 부품·패턴 카탈로그" noindex>
  <div class="wrap" data-deco="4">
    <header class="page-head">
      <p class="kicker">DECO KIT · 빵관 토니</p>
      <h1>다이어리 데코 키트</h1>
      <p class="lede">
        기존 팔레트를 유지한 채 종이·테이프·스티커 질감만 얹는 부품 모음입니다. 전부
        CSS 로 그려 이미지 없이 붙고, 각 부품은 각도·위치만 바꿔 재사용합니다. 코드
        (<code>T1</code>, <code>S3</code> …)로 지정해 배치합니다.
      </p>
    </header>

    <!-- ══ 01 부품 카탈로그 ══ -->
    <h2 class="sec"><span class="no">01</span> 부품 카탈로그 <small>호버하면 살짝 갸웃합니다</small></h2>

    <p class="group">MASKING TAPE</p>
    <div class="grid">
      <figure class="cell"><span class="code">T1</span><span class="stage"><span style="transform:rotate(-5deg)"><Tape variant="check" /></span></span><figcaption>체크 · 버터</figcaption></figure>
      <figure class="cell"><span class="code">T2</span><span class="stage"><span style="transform:rotate(4deg)"><Tape variant="stripe" /></span></span><figcaption>사선 스트라이프 · 핑크</figcaption></figure>
      <figure class="cell"><span class="code">T3</span><span class="stage"><span style="transform:rotate(-2deg)"><Tape variant="vellum" /></span></span><figcaption>무지 벨럼 · 반투명</figcaption></figure>
      <figure class="cell"><span class="code">T4</span><span class="stage"><span style="transform:rotate(-7deg)"><Tape variant="letter" width={154} /></span></span><figcaption>레터링 테이프</figcaption></figure>
      <figure class="cell"><span class="code">T5</span><span class="stage"><span style="transform:rotate(3deg)"><Tape variant="dot" /></span></span><figcaption>도트 테이프</figcaption></figure>
      <figure class="cell"><span class="code">T6</span><span class="stage"><span style="transform:rotate(-4deg)"><Tape variant="kraft" /></span></span><figcaption>찢은 크라프트</figcaption></figure>
    </div>

    <p class="group">STICKER</p>
    <div class="grid">
      <figure class="cell wide"><span class="code">S1</span><span class="stage row gap"><span style="transform:rotate(-4deg)"><Sticker variant="speech" text="오늘도 빵빵하게!" /></span><span style="transform:rotate(5deg)"><Sticker variant="speech" tone="blue" text="빵-하!" /></span></span><figcaption>말풍선 — 핑크 · 블루<br /><small>손글씨로 끄적인 것은 말풍선이 아니라 D6+D3 (아래 P-02)</small></figcaption></figure>
      <figure class="cell"><span class="code">S2</span><span class="stage"><span style="transform:rotate(-2deg)"><Sticker variant="ribbon" text="EP 07 · 완결" /></span></span><figcaption>리본 배너</figcaption></figure>
      <figure class="cell"><span class="code">S3</span><span class="stage"><Sticker variant="star" /></span><figcaption>별 스티커 3종</figcaption></figure>
      <figure class="cell"><span class="code">S4</span><span class="stage"><span style="transform:rotate(8deg)"><Sticker variant="diecut" text="빵-하!" /></span></span><figcaption>원형 다이컷</figcaption></figure>
      <figure class="cell"><span class="code">S5</span><span class="stage"><span style="transform:rotate(-6deg)"><Sticker variant="tag" text="TECH · 29MIN" /></span></span><figcaption>택 라벨</figcaption></figure>
      <figure class="cell"><span class="code">S6</span><span class="stage"><span style="transform:rotate(-5deg)"><Sticker variant="tony" size={96} /></span></span><figcaption>토니 다이컷</figcaption></figure>
      <figure class="cell"><span class="code">S7</span><span class="stage"><span style="transform:rotate(-2.5deg)"><Sticker variant="name-plate" text="빵관 토니" /></span></span><figcaption>이름 라벨</figcaption></figure>
      <figure class="cell"><span class="code">S8</span><span class="stage"><span style="transform:rotate(4deg)"><Sticker variant="name-pill" text="토니의 기록장" /></span></span><figcaption>이름 다이컷</figcaption></figure>
      <figure class="cell"><span class="code">S9</span><span class="stage"><span style="transform:rotate(1.5deg)"><Sticker variant="name-blank" text="토니" /></span></span><figcaption>이름 기입 라벨</figcaption></figure>
    </div>

    <p class="group">DOODLE</p>
    <div class="grid">
      <figure class="cell"><span class="code">D1</span><span class="stage"><Doodle variant="sparkle" /></span><figcaption>반짝 (4각)</figcaption></figure>
      <figure class="cell"><span class="code">D2</span><span class="stage"><Doodle variant="heart" /></span><figcaption>하트</figcaption></figure>
      <figure class="cell"><span class="code">D3</span><span class="stage"><Doodle variant="arrow" /></span><figcaption>곡선 화살표</figcaption></figure>
      <figure class="cell"><span class="code">D4</span><span class="stage"><span class="stack"><b>밑줄 두들</b><Doodle variant="wave" width={140} /></span></span><figcaption>물결 밑줄</figcaption></figure>
      <figure class="cell"><span class="code">D5</span><span class="stage"><Doodle variant="emphasis" /></span><figcaption>강조선 · 별표</figcaption></figure>
      <figure class="cell"><span class="code">D6</span><span class="stage"><span style="transform:rotate(-3deg)"><Doodle variant="memo" text={"여기부터 읽으면\n편해요 :)"} /></span></span><figcaption>손글씨 메모</figcaption></figure>
      <figure class="cell"><span class="code">D7</span><span class="stage"><span style="transform:rotate(-4deg)"><Doodle variant="scribble-heart" /></span></span><figcaption>낙서 하트<br /><small>D2 하트와 다르다 — 이쪽은 굵게 두르고 칠한 것</small></figcaption></figure>
      <figure class="cell"><span class="code">D8</span><span class="stage"><span style="transform:rotate(3deg)"><Doodle variant="bolt" /></span></span><figcaption>번개 두들</figcaption></figure>
      <figure class="cell"><span class="code">D9</span><span class="stage"><span style="transform:rotate(-2deg)"><Doodle variant="barley" /></span></span><figcaption>보리 · 잎사귀</figcaption></figure>
      <figure class="cell"><span class="code">D10</span><span class="stage"><span style="transform:rotate(-3deg)"><Doodle variant="speech-balloon" text={"이거\n진짜 좋아!"} /></span></span><figcaption>말풍선<br /><small>S1 말풍선 스티커와 다르다 — 이쪽은 붙인 게 아니라 그린 것</small></figcaption></figure>
      <figure class="cell"><span class="code">D11</span><span class="stage"><span style="transform:rotate(4deg)"><Doodle variant="burst-balloon" text="우와!!" /></span></span><figcaption>폭발 말풍선</figcaption></figure>
      <figure class="cell"><span class="code">D12</span><span class="stage"><span style="transform:rotate(-2deg)"><Doodle variant="thought-balloon" text={"음…\n고민중"} /></span></span><figcaption>생각 풍선</figcaption></figure>
    </div>

    <p class="group">DOODLE MARK <small>이모지 자리에 놓는 손그림 기호</small></p>
    <p class="note-p">
      본문에서 <code>❌</code>·<code>✅</code>·<code>⚠</code> 가 놓이던 자리에 넣습니다.
      다른 부품과 달리 <b>여백이 아니라 문장 안</b>에 앉고, 뜻을 지고 있어서
      <code>data-deco</code> 강도로 사라지지 않으며 기본으로
      <code>aria-label</code>을 답니다. MDX 본문에서는 import 없이
      <code>&lt;Mark name="no" /&gt;</code> 로 씁니다.
      크기는 <code>size</code>(기본 <code>1.15em</code>) 하나로 정해지고
      <code>em</code> 이라 앉은 자리의 글자 크기를 따라갑니다.
    </p>
    <div class="marks">
      {
        MARK_NAMES.map((n) => (
          <figure class="mark-cell">
            <span class="mark-stage">
              <DoodleMark name={n} label={false} />
            </span>
            <figcaption>
              <b>{DOODLE_MARKS[n].label}</b>
              <code>{n}</code>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <div class="mark-demo">
      <p class="mark-demo-h">본문에 앉은 모습 — 크기는 글자를 따라간다</p>
      <ul>
        <li>
          <DoodleMark name="no" /> <b>"VPN은 암호화된 프록시다."</b> → 계층과 적용
          범위가 다릅니다.
        </li>
        <li>
          <DoodleMark name="check" /> 터널은 <b>인터페이스</b>로 붙습니다 — 라우팅
          표가 트래픽의 향방을 정합니다.
        </li>
        <li>
          <DoodleMark name="warn" /> 리프레시 토큰을 회전 없이 오래 쓰면 유출
          한 번이 영구 권한이 됩니다.
        </li>
      </ul>
      <p>
        문단 안에서도 같은 크기로 앉습니다 <DoodleMark name="haha" /> — 제목에
        쓰면 제목 크기를 따라갑니다.
      </p>
      <h3>제목에 앉은 마크 <DoodleMark name="star" /></h3>
    </div>

    <p class="group">CLIP · HANG · MEMO · FRAME · PAPER</p>
    <div class="grid">
      <figure class="cell"><span class="code">C1</span><span class="stage gap"><span style="transform:rotate(-16deg)"><Clip variant="clip" /></span><Clip variant="binder" /></span><figcaption>종이 클립 · 집게</figcaption></figure>
      <figure class="cell"><span class="code">W1</span><span class="stage"><Twine width={172} sag={62}><span class="w1-tag"></span></Twine></span><figcaption>마 실 · 걸이줄<br /><small>처짐이 없으면 밑줄로 읽힌다</small></figcaption></figure>
      <figure class="cell"><span class="code">W2</span><span class="stage gap"><span style="transform:rotate(-9deg)"><Clothespin height={66} /></span><span style="transform:rotate(14deg)"><Clothespin height={58} /></span></span><figcaption>나무 집게 2종</figcaption></figure>
      <figure class="cell wide"><span class="code">W3</span><span class="stage"><span class="w3-line"><Twine width={240} sag={64} /><span class="w3-item left"><Polaroid width={54}><img src={TONY_DIECUT} alt="" width="30" height="41" /></Polaroid><span class="w3-pin"><Clothespin height={32} /></span></span><span class="w3-item right"><StickyNote text="오늘 할 일" width={64} /><span class="w3-pin"><Clothespin height={30} /></span></span></span></span><figcaption>실 + 집게 조합<br /><small>부품 셋을 그 자리에서 얹는 조합 — 컴포넌트로 굳히지 않았다</small></figcaption></figure>
      <figure class="cell"><span class="code">M1</span><span class="stage"><span style="transform:rotate(3deg)"><StickyNote text={"MTU 1420,\n여기서 막힘!"} /></span></span><figcaption>포스트잇 메모</figcaption></figure>
      <figure class="cell"><span class="code">M2</span><span class="stage gap"><IndexTab text="최근 글" tone="pink" /><IndexTab text="글 지도" tone="blue" /></span><figcaption>인덱스 탭</figcaption></figure>
      <figure class="cell"><span class="code">F1</span><span class="stage"><span style="transform:rotate(-3deg)"><Polaroid caption="빵관 토니 ♡" width={74}><img src={TONY_DIECUT} alt="" width="40" height="55" /></Polaroid></span></span><figcaption>폴라로이드 프레임</figcaption></figure>
      <figure class="cell"><span class="code">F2</span><span class="stage"><CornerMount><PaperSurface paper="dot" tone="cream" cell={11} width="96px" height="66px" /></CornerMount></span><figcaption>사진 코너 마운트</figcaption></figure>
      <figure class="cell"><span class="code">P1</span><span class="stage gap"><span style="transform:rotate(-8deg)"><Stamp variant="date" text="2026.07.28" /></span><span style="transform:rotate(-11deg)"><Stamp variant="round" text="BAKED" sub="빵관토니" /></span></span><figcaption>날짜 · 도장 스탬프</figcaption></figure>
      <figure class="cell"><span class="code">P2</span><span class="stage"><span style="transform:rotate(-2deg)"><TicketStub code="EP 07" note="29분 읽기" notch="var(--surface)" /></span></span><figcaption>티켓 스텁</figcaption></figure>
      <figure class="cell wide"><span class="code">B1</span><span class="stage row"><PaperSurface paper="grid" tone="cream" cell={16} width="74px" height="80px" /><PaperSurface paper="dot" tone="cream" cell={14} width="74px" height="80px" /><PaperSurface paper="ruled" tone="cream" cell={16} width="74px" height="80px" /></span><figcaption>모눈 · 도트 · 노트 종이</figcaption></figure>
    </div>

    <p class="group">
      PHOTO FRAME <small>사진 한 장을 담는 액자 12종</small>
    </p>
    <p class="note-p">
      위 부품들이 조각 하나라면 이쪽은 <b>사진을 담는 액자</b>입니다. F1·F2 와 겹쳐
      보이지만 격이 다릅니다 — F1·F2 는 액자 부품 자체이고, PF1~PF12 는 거기에
      테이프·집게·도장을 얹어 굳힌 <b>조합</b>이라 사는 곳도
      <code>components/deco/patterns/</code> 입니다. 표는
      <code>src/lib/photoFrames.ts</code> 하나이고 부품과 이 카탈로그가 같이 읽습니다.
      아래는 <b>사진을 안 넣은 상태</b>라 종이 무늬가 그대로 보입니다 — 사진을 넣으면
      그 칸을 <code>object-fit: cover</code> 로 채웁니다.
      얹은 것(테이프·탭·도장·말풍선)은 티어 2~4 라 강도로 접히지만 액자 자체는
      남습니다. <b>PF2 만 예외로 티어 1</b> 입니다 — 거기서는 테이프가 곧 액자라
      접으면 사진만 남습니다.
    </p>
    <div class="pf-grid">
      {
        PHOTO_FRAMES.map((f) => (
          <figure class="pf-cell">
            <span class="code">{f.code}</span>
            <span class="pf-stage">
              <PhotoFrame
                variant={f.variant}
                width={PF_DEMO[f.variant].width}
                caption={PF_DEMO[f.variant].caption}
                label={PF_DEMO[f.variant].label}
                note={PF_DEMO[f.variant].note}
              />
            </span>
            <figcaption>
              {f.label}
              <br />
              <small>{f.note}</small>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p class="group">
      FRAME PICK <small>어떤 케이스에 어떤 액자를 쓰나</small>
    </p>
    <p class="note-p">
      액자가 열둘이라 그때그때 고르면 같은 성격의 그림이 지면마다 다른 액자를 입습니다.
      그래서 고르는 일을 표에 맡깁니다 — 축은 넷이고(담는 것 · 칸 수 · 비율 · 자리),
      각 액자가 감당할 수 있는 범위는 <code>photoFrames.ts</code> 의 <code>caps</code> 에
      있습니다. <b>아래 표는 문서가 아니라 그 로직을 지금 돌린 결과입니다</b> —
      <code>judgePhotoFrames()</code> 의 반환값을 그대로 그리므로 규칙과 갈릴 수가 없습니다.
      통과한 것은 <b>조용한 순</b>으로 세웁니다(상한을 안 넘는 한 시끄러운 쪽이 나을 이유가
      없고, 여럿 나란히 서는 자리에서는 조용한 쪽이 반복을 견딥니다).
    </p>
    <div class="picks">
      {
        FRAME_CASES.map((c) => {
          const pass = pickPhotoFrames(c.case);
          const fail = judgePhotoFrames(c.case).filter((v) => v.rejects.length);
          return (
            <section class="pick">
              <p class="pick-head">
                <b>{c.where}</b>
                <code>
                  {c.case.content} · {c.case.orient ?? "wide"} ·{" "}
                  {c.case.surface}
                </code>
              </p>
              <p class="pick-note">{c.note}</p>
              <p class="pick-row">
                <span class="pick-tag ok">통과 {pass.length}</span>
                {pass.length ? (
                  pass.map((f, i) => (
                    <span class:list={["chip", { first: i === 0 }]}>
                      <b>{f.code}</b> {f.label}
                      <i>noise {f.caps.noise}</i>
                    </span>
                  ))
                ) : (
                  <span class="chip none">쓸 수 있는 액자 없음</span>
                )}
              </p>
              <p class="pick-row">
                <span class="pick-tag no">탈락 {fail.length}</span>
                {fail.map((v) => (
                  <span class="chip dim">
                    <b>{v.frame.code}</b>
                    {v.rejects.map((r) => (
                      <i>{REJECT_LABEL[r]}</i>
                    ))}
                  </span>
                ))}
              </p>
            </section>
          );
        })
      }
