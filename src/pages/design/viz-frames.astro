---
/**
 * viz 액자 프레임 — /design/viz-frames  (KAN-063)
 *
 * 본문 다이어그램(viz)을 감싸는 액자 8종을 **실제 그림에 씌워** 그린다. 기본값
 * (`polaroid` — 유저 선택)이 왜 그것인지와 나머지를 언제 덮어쓸지를 고르는
 * 페이지라, 문서가 아니라 화면이 판단 근거다.
 *
 * 부품은 `src/components/viz/VizFigure.tsx` 의 `frame` prop, 그림은
 * `src/styles/viz-frame.css`, 샘플은 `src/components/viz/samples/`.
 *
 * `deco.css` 를 들여오는 이유가 둘이다 — 테이프 색(`--deco-tape-*`)과 강도 게이트
 * (`[data-deco="n"]`). 없으면 절 05 가 아무것도 안 보여준다.
 *
 * 독자용 페이지가 아니라 noindex + 사이트맵 제외(astro.config.mjs).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import SampleComparison from "../../components/viz/samples/SampleComparison";
import SampleFlowchart from "../../components/viz/samples/SampleFlowchart";
import SampleProcessSteps from "../../components/viz/samples/SampleProcessSteps";
import type { VizFrame } from "../../components/viz/VizFigure";
import "../../styles/deco.css";

interface FrameEntry {
  code: string;
  value: VizFrame;
  name: string;
  note: string;
  /** 물려받은 데코 부품(있으면) */
  from?: string;
}

const FRAMES: FrameEntry[] = [
  { code: "F-A", value: "polaroid", name: "폴라로이드", note: "흰 판 + 가운데 위 마테 + 손글씨 캡션. 본문 도식의 기본값 — 유저 선택", from: "PF1 폴라로이드 + 마테" },
  { code: "—", value: "none", name: "액자 없음", note: "액자를 끈 그림의 탈출구 — 옛 렌더 그대로" },
  { code: "F-D", value: "scrapbook", name: "스크랩북", note: "도트 종이 판 + 네 귀퉁이 홀더 — 그림을 하나도 안 가린다", from: "PF3 코너 마운트 · 스크랩북" },
  { code: "F-H", value: "note", name: "메모 폴라로이드", note: "마테를 떼고 캡션을 말린 화살표·손글씨 메모 두들로 바꾼 판. 아래 여백은 F-A 그대로", from: "PF1 + D3 화살표 · D6 메모" },
  { code: "F-B", value: "taped", name: "테이프 판", note: "모눈 종이 + 위 모서리 테이프 두 장", from: "P-01 TapedBoard · T1/T3" },
  { code: "F-C", value: "kraft", name: "찢은 크라프트", note: "네 변이 다 찢긴 판 — 오려 붙인 조각", from: "PF6 찢은 크라프트" },
  { code: "F-G", value: "crayon", name: "크레용 테두리", note: "크레용 밑선 + 잉크 선 이중 테두리 + 별 하나. 손맛이 SVG 필터라 이 액자만 마크업이 붙는다", from: "PF7 크레용 테두리" },
  { code: "F-E", value: "quiet", name: "조용한 액자", note: "1px 테두리 + 얕은 그림자. 캡션은 액자 밖" },
  { code: "F-F", value: "bare", name: "바탕만", note: "테두리 없이 바탕색 + 여백. 현행에서 한 걸음" },
];

const DECO_TIERED: VizFrame[] = ["polaroid", "note", "taped", "crayon"];
---

<BaseLayout
  title="viz 액자 프레임"
  description="본문 다이어그램을 감싸는 액자 8종 카탈로그"
  noindex
>
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">VIZ FRAME · KAN-063</p>
      <h1>viz 액자 프레임</h1>
      <p class="lede">
        본문 다이어그램을 감싸는 액자 여덟 가지입니다. 그림 자체는 그대로 두고
        <b>바깥 껍데기만</b> 바뀝니다. 여섯은 데코 키트 부품에서 짜임을 물려받았고
        (<code>F-A</code>~<code>F-D</code>·<code>F-G</code>·<code>F-H</code>), 둘은 읽는
        화면 쪽으로 차분하게 뺀 선택지입니다(<code>F-E</code>·<code>F-F</code>).
      </p>
      <p class="lede warn">
        발행된 글의 도식 41개는 지금 <b>전부 <code>polaroid</code>(F-A)</b>를 입고
        있습니다 — 후보 여덟을 보고 고른 값이고, 기본값이라 글마다 지정하지 않습니다.
        <b>귀퉁이 두들 마크는 안 붙입니다</b>(같은 자리에서 함께 고른 것).
        한 그림만 달리 입히려면 그 자리에서
        <code>frame="…"</code>으로 덮습니다(<code>"none"</code> 포함).
        <b>고르는 자리는 여기가 아니라 <a href="/design/frame-picks">/design/frame-picks</a>입니다</b> —
        이 페이지는 무늬를 비교하는 카탈로그이고, 그쪽은 같은 액자를 실제 글의 문단
        사이에 놓습니다.
      </p>
    </header>

    <!-- ══ 01 한눈 비교 ══ -->
    <h2 class="sec"><span class="no">01</span> 한눈 비교 <small>같은 그림, 액자만 다름</small></h2>
    <div class="grid">
      {
        FRAMES.map((f) => (
          <section class="cell">
            <p class="cell-head">
              <span class="code">{f.code}</span>
              <b>{f.name}</b>
              {f.from && <span class="from">{f.from}</span>}
            </p>
            <div class="stage">
              <SampleComparison frame={f.value} />
            </div>
            <p class="cell-note">{f.note}</p>
          </section>
        ))
      }
    </div>

    <!-- ══ 02 비율 견디기 ══ -->
    <h2 class="sec">
      <span class="no">02</span> 비율 견디기
      <small>Comparison·ProcessSteps 는 높이를 콘텐츠에서 되뽑고, Flowchart 는 저작 viewBox 고정</small>
    </h2>
    <p class="note-p">
      액자 아래에 빈 띠가 끼거나 그림이 letterbox 되는지는 <b>비율이 다른 그림</b>에
      씌워 봐야 압니다. 세 kind 를 같은 액자로 나란히 놓습니다.
    </p>
    {
      FRAMES.filter((f) => f.value !== "none").map((f) => (
        <section class="pat">
          <p class="pat-head">
            <span class="pid">{f.code}</span> {f.name}
          </p>
          <div class="triple">
            <div><SampleComparison frame={f.value} /></div>
            <div><SampleProcessSteps frame={f.value} /></div>
            <div><SampleFlowchart frame={f.value} /></div>
          </div>
        </section>
      ))
    }

    <!-- ══ 03 본문 폭 안에서 ══ -->
    <h2 class="sec"><span class="no">03</span> 본문 폭 안에서 <small>720px — 실제 글이 이 폭입니다</small></h2>
    <p class="note-p">
      위 칸들은 넓어서 액자가 넉넉해 보입니다. 실제 지면은
      <code>--content-max: 720px</code> 이고, SVG 가 <code>width:100%</code> 라
      <b>액자 패딩만큼 그림이 줄고 글씨도 같은 비율로 작아집니다</b>. 이 축소는
      <code>viz:verify</code> 가 못 잡습니다(그건 viewBox 단위로 잽니다) — 그래서 이
      절이 있습니다.
    </p>
    <div class="measure">
      {
        FRAMES.map((f) => (
          <section class="m-row">
            <p class="m-head">
              <span class="code">{f.code}</span> {f.name}
            </p>
            <SampleProcessSteps frame={f.value} />
          </section>
        ))
      }
    </div>

    <!-- ══ 04 캡션 유무 ══ -->
    <h2 class="sec"><span class="no">04</span> 캡션이 없을 때 <small>폴라로이드는 캡션이 액자 구조의 일부입니다</small></h2>
    <p class="note-p">
      <code>F-A</code> 는 아래가 두꺼운 것이 물성이라, 캡션이 없으면 그 여백을 무엇이
      대신할지 정해야 합니다(지금은 아래 패딩을 38px 로 늘려 뒀습니다).
      <code>F-E</code>·<code>F-F</code> 는 캡션이 액자 <b>밖</b>이라 없어도 액자가 안 변합니다.
    </p>
    <div class="grid two">
      {
        (["polaroid", "quiet"] as VizFrame[]).map((v) => {
          const f = FRAMES.find((x) => x.value === v)!;
          return (
            <>
              <section class="cell">
                <p class="cell-head"><span class="code">{f.code}</span> <b>{f.name}</b> — 캡션 있음</p>
                <div class="stage"><SampleComparison frame={v} /></div>
              </section>
              <section class="cell">
                <p class="cell-head"><span class="code">{f.code}</span> <b>{f.name}</b> — 캡션 없음</p>
                <div class="stage"><SampleComparison frame={v} caption={false} /></div>
              </section>
            </>
          );
        })
      }
    </div>

    <!-- ══ 05 강도 ══ -->
    <h2 class="sec"><span class="no">05</span> 강도 <small>판은 남고, 얹은 것만 접힙니다</small></h2>
    <p class="note-p">
      데코 키트의 강도 게이트(<code>data-deco</code>)를 액자에도 그대로 물립니다. 다만
      <b>티어를 지는 것은 테이프·코너뿐</b>입니다 — 종이 판·패딩·테두리가 강도에 따라
      사라지면 데코가 아니라 그림 크기가 페이지 설정에 끌려다닙니다. 글 상세는 강도 3
      입니다.
    </p>
    <div class="int-grid">
      {
        [2, 3, 4].map((lv) => (
          <section class="int-cell" data-deco={lv}>
            <p class="cell-head"><span class="code">강도 {lv}</span></p>
            {DECO_TIERED.map((v) => (
              <div class="stage"><SampleComparison frame={v} caption={false} /></div>
            ))}
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: var(--space-48) var(--page-pad) var(--space-64);
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.2em;
    color: var(--ink-3);
  }
  .page-head h1 {
    margin: var(--space-8) 0 var(--space-14);
    font-size: var(--text-h1);
  }
  .lede {
    max-width: 60ch;
    color: var(--ink-2);
    line-height: 1.75;
  }
  .lede.warn {
    margin-top: var(--space-10);
    padding: var(--space-12) var(--space-14);
    border-left: var(--stroke-bold) solid var(--pop);
    background: var(--pop-tint);
    color: var(--pop-ink);
  }

  .sec {
    margin: var(--space-48) 0 var(--space-14);
    padding-bottom: var(--space-8);
    border-bottom: var(--stroke-hair) solid var(--border);
    font-size: var(--text-h3);
  }
  .sec .no {
    font-family: var(--font-mono);
    color: var(--accent);
    margin-right: var(--space-8);
  }
  .sec small {
    margin-left: var(--space-10);
    font-size: var(--text-meta);
    font-weight: 400;
    color: var(--ink-3);
  }
  .note-p {
    max-width: 68ch;
    margin: 0 0 var(--space-24);
    color: var(--ink-2);
    line-height: 1.75;
    font-size: var(--text-meta);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-24);
  }
  .grid.two {
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  }
  .cell-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
    margin: 0 0 var(--space-10);
    font-size: var(--text-meta);
  }
  .code {
    padding: var(--space-2) var(--space-6);
    border-radius: var(--radius-sm);
    background: var(--accent-tint2);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 700;
  }
  .from {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--ink-3);
  }
  .cell-note {
    margin: var(--space-8) 0 0;
    font-size: var(--text-meta);
    color: var(--ink-3);
    line-height: 1.6;
  }
  /* 판 밖으로 나가는 것(테이프)이 윗칸을 물지 않게 여유를 둔다. 필요한 최소는
     실측 24.7px 이다 — 테이프가 top:-14px·-10° 라 판 밖 그만큼 올라간다(DECO_KIT §7).
     간격 눈금(§9)에서 그 위 첫 단이 32px 이라 --space-32 를 쓴다(옛 값 30px). */
  .stage {
    padding-top: var(--space-32);
  }
  /* 카탈로그에서는 figure 의 위아래 28px 마진이 칸 사이 gap 과 겹쳐 보인다 */
  .stage :global(.viz-figure) {
    margin: 0;
  }

  .pat {
    margin-bottom: var(--space-32);
  }
  .pat-head {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    margin: 0 0 var(--space-12);
    font-size: var(--text-meta);
    font-weight: 700;
  }
  .pid {
    padding: var(--space-2) var(--space-6);
    border-radius: var(--radius-sm);
    background: var(--cream);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--ink-2);
  }
  .triple {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-24);
    align-items: start;
  }
  .triple > div {
    padding-top: var(--space-32);
  }
  .triple :global(.viz-figure) {
    margin: 0;
  }

  .measure {
    max-width: var(--content-max);
  }
  .m-row {
    margin-bottom: var(--space-32);
    padding-top: var(--space-32);
  }
  .m-head {
    margin: 0 0 var(--space-10);
    font-size: var(--text-meta);
    color: var(--ink-2);
  }

  .int-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-24);
    align-items: start;
  }
  .int-cell .stage + .stage {
    margin-top: var(--space-24);
  }
</style>
