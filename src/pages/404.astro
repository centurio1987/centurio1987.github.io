---
import BaseLayout from "../layouts/BaseLayout.astro";
import Mascot from "../components/motifs/Mascot.astro";
import { HOME_URL } from "../lib/urls";
---

<BaseLayout title="404" description="페이지를 찾지 못했습니다.">
  <section class="wrap">
    <Mascot size={96} />
    <h1>404</h1>
    <p class="msg">이 페이지는 아직 초안(raw)입니다. 토니가 못 찾았어요.</p>
    <a href={HOME_URL} class="home">홈으로 →</a>
  </section>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-96) var(--page-pad);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
  }
  h1 {
    /* 이 숫자가 이 지면의 Display 역할이다 — 고정 64px 이던 것을 역할 토큰으로
       옮겼다. 데스크톱 60px · 390px 36px 로 좁은 화면에서는 함께 줄어든다. */
    font-size: var(--text-display);
    /* 800 이던 것을 Bold 로 접었다 — 그 면이 실재한 적이 없어 브라우저가 700 으로 대체해
       그리고 있었다(§5 「600 과 800 은 700 으로 접는다」). 화면은 안 바뀐다. */
    font-weight: var(--font-weight-bold);
    margin: var(--space-8) 0 0;
  }
  .msg {
    color: var(--ink-2);
    margin: 0 0 var(--space-16);
  }
  .home {
    /* 600 → Bold. 위 h1 과 같은 이유다. */
    font-weight: var(--font-weight-bold);
    color: var(--ink);
    background: var(--pop);
    border: var(--stroke-bold) solid var(--ink);
    padding: var(--space-8) var(--space-16);
    border-radius: var(--radius-md);
  }
</style>
