---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import GraphExplorer from "../components/graph/GraphExplorer.tsx";
import type {
  GraphViewData,
  GraphViewLink,
} from "../components/graph/GraphExplorer.tsx";
import { getCategory } from "../lib/categories";
import { graphData, hasGraphData } from "../lib/graph";
import { formatMonthYear, formatYear } from "../lib/format";
import TapedBoard from "../components/deco/patterns/TapedBoard.astro";
import ClippedCard from "../components/deco/patterns/ClippedCard.astro";
import DecoHeading from "../components/deco/patterns/DecoHeading.astro";
import DecoLayer from "../components/deco/DecoLayer.astro";
import IndexTab from "../components/deco/IndexTab.astro";
import Tape from "../components/deco/Tape.astro";
import "../styles/deco.css";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) =>
    b.data.pubDate.getTime() - a.data.pubDate.getTime() ||
    b.id.localeCompare(a.id),
);
const bySlug = new Map(posts.map((p) => [p.id, p]));

// ── 글별 키워드(개념) ──
// KAN-029: 개념은 더 이상 초기 뷰의 노드가 아니다. 글 노드에 포인터를 올렸을 때만
// 그 글의 연관 키워드로 펼쳐지므로, 글 단위로 접어서 넘긴다(페이로드도 크게 준다).
const KEYWORDS_PER_POST = 8;
const conceptsBySlug = new Map<string, Map<string, number>>();
for (const c of graphData.concepts) {
  if (!c.postSlug || !bySlug.has(c.postSlug)) continue;
  let m = conceptsBySlug.get(c.postSlug);
  if (!m) {
    m = new Map();
    conceptsBySlug.set(c.postSlug, m);
  }
  m.set(c.label, Math.max(m.get(c.label) ?? 0, c.degree)); // 같은 라벨은 최대 degree로
}

// ── 글↔글 엣지 ──
// 세 가지 신호를 한 쌍으로 합친다: ① 개념 공유(graphify postPairs) ② 본문 인용(문서 노드 간
// 직접 엣지) ③ 같은 시리즈의 이웃 화. 정렬된 (a,b) 를 캐논 키로 써서 중복을 막는다.
interface PairAgg {
  a: string;
  b: string;
  conceptScore: number;
  citeCount: number;
  series: string | null;
  shared: string[];
}
const pairs = new Map<string, PairAgg>();
function touch(x: string, y: string): PairAgg {
  const [a, b] = [x, y].sort();
  const key = `${a}|${b}`;
  let v = pairs.get(key);
  if (!v) {
    v = { a, b, conceptScore: 0, citeCount: 0, series: null, shared: [] };
    pairs.set(key, v);
  }
  return v;
}

for (const p of graphData.postPairs) {
  if (!bySlug.has(p.a) || !bySlug.has(p.b)) continue;
  const v = touch(p.a, p.b);
  v.conceptScore = Math.max(v.conceptScore, p.score);
  v.shared = p.sharedConcepts.slice(0, 4);
}
for (const e of graphData.conceptEdges) {
  if (!e.source.startsWith("post:") || !e.target.startsWith("post:")) continue;
  const a = e.source.slice(5);
  const b = e.target.slice(5);
  if (a === b) continue; // 자기 참조(같은 글 안의 references)는 엣지가 아니다
  if (!bySlug.has(a) || !bySlug.has(b)) continue;
  touch(a, b).citeCount += 1;
}
// 시리즈는 클리크로 이으면 지도가 뭉개진다 — order 순 이웃 화만 체인으로 잇는다.
const seriesGroups = new Map<string, typeof posts>();
for (const p of posts) {
  if (!p.data.series) continue;
  const g = seriesGroups.get(p.data.series) ?? [];
  g.push(p);
  seriesGroups.set(p.data.series, g);
}
for (const [name, group] of seriesGroups) {
  const ordered = [...group].sort(
    (x, y) =>
      (x.data.order ?? 0) - (y.data.order ?? 0) || x.id.localeCompare(y.id),
  );
  for (let i = 1; i < ordered.length; i++) {
    touch(ordered[i - 1].id, ordered[i].id).series = name;
  }
}

const SERIES_STRENGTH = 0.5;
const links: GraphViewLink[] = [...pairs.values()]
  .map((v) => {
    const cite = v.citeCount ? Math.min(0.35 + 0.08 * v.citeCount, 0.75) : 0;
    const strength = Math.min(
      1,
      Math.max(v.conceptScore, v.series ? SERIES_STRENGTH : 0, cite),
    );
    const kinds: GraphViewLink["kinds"] = [];
    if (v.conceptScore > 0) kinds.push("concept");
    if (v.citeCount > 0) kinds.push("cites");
    if (v.series) kinds.push("series");
    return {
      source: `post:${v.a}`,
      target: `post:${v.b}`,
      strength: Number(strength.toFixed(3)),
      kinds,
      shared: v.shared,
      seriesLabel: v.series ?? undefined,
    };
  })
  .sort((x, y) => (x.source + x.target < y.source + y.target ? -1 : 1));

// ── 기간 축: 범위 게이지용 버킷 (KAN-051) ──
// 칩이 아니라 끌어서 범위를 잡는 게이지이므로, 글이 없는 달도 **칸을 차지해야** 한다.
// 있는 달만 늘어놓으면 5월과 9월이 나란히 붙어 시간축이 거짓말을 한다. 그래서 처음
// 글부터 마지막 글까지 **연속 도메인**을 만들고 count 0 인 칸도 그대로 남긴다.
//
// 눈금 단위는 데이터에 적응한다 — 36개월(3년)까지는 월, 넘으면 연으로 접는다.
// 글이 쌓여 3년을 넘기는 날 코드 수정 없이 연 단위로 승격된다.
// 라벨·정렬·집계를 전부 여기서 끝내고 클라이언트는 map 만 한다(hydration 안전).
const MONTH_SPAN_MAX = 36;
const ymOf = (d: Date) => d.getFullYear() * 12 + d.getMonth();
const ymValues = posts.map((p) => ymOf(p.data.pubDate));
const ymLo = Math.min(...ymValues);
const ymHi = Math.max(...ymValues);
const periodMode: "year" | "month" =
  ymHi - ymLo + 1 <= MONTH_SPAN_MAX ? "month" : "year";

const periodKeyOf = (d: Date) =>
  periodMode === "year"
    ? String(d.getFullYear())
    : `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;

const periodCount = new Map<string, number>();
for (const p of posts) {
  const key = periodKeyOf(p.data.pubDate);
  periodCount.set(key, (periodCount.get(key) ?? 0) + 1);
}

// 오름차순 연속 버킷. 라벨은 사이트 표기 규약을 그대로 쓴다(formatYear/formatMonthYear
// 둘 다 Intl 미사용 → SSR/CSR 동일). 키는 고정 폭 제로패딩이라 코드포인트 비교로 충분
// 하다(localeCompare 금지 — 서버/브라우저 collation 차이가 hydration mismatch 를 낸다).
const periodBuckets: { key: string; label: string; count: number }[] = [];
if (periodMode === "year") {
  for (let y = Math.floor(ymLo / 12); y <= Math.floor(ymHi / 12); y++) {
    const key = String(y);
    periodBuckets.push({
      key,
      label: formatYear(new Date(y, 0, 1)),
      count: periodCount.get(key) ?? 0,
    });
  }
} else {
  for (let m = ymLo; m <= ymHi; m++) {
    const d = new Date(Math.floor(m / 12), m % 12, 1);
    const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
    periodBuckets.push({
      key,
      label: formatMonthYear(d),
      count: periodCount.get(key) ?? 0,
    });
  }
}

const viewPosts = posts.map((p) => {
  const cat = getCategory(p.data.category);
  const byLabel = conceptsBySlug.get(p.id) ?? new Map<string, number>();
  const ranked = [...byLabel.entries()].sort(
    (a, b) => b[1] - a[1] || (a[0] < b[0] ? -1 : 1),
  );
  // 그래프에 아직 없는 글(추출 대기)은 frontmatter 태그로 degrade — 호버가 빈손이 되지 않게.
  const keywords = ranked.length
    ? ranked.slice(0, KEYWORDS_PER_POST).map(([label]) => label)
    : p.data.tags.slice(0, KEYWORDS_PER_POST);
  return {
    slug: p.id,
    title: p.data.title,
    categoryLabel: cat.label,
    color: cat.color,
    tags: p.data.tags,
    keywords,
    // 검색은 개념 노드가 사라져도 유지된다 — 글의 모든 개념 라벨을 검색 텍스트에 접어 넣는다.
    searchText: [p.data.title, ...p.data.tags, ...ranked.map(([l]) => l)]
      .join(" ")
      .toLowerCase(),
    periodKey: periodKeyOf(p.data.pubDate),
  };
});

const legendCats = [...new Set(posts.map((p) => p.data.category))].map((slug) => {
  const cat = getCategory(slug);
  return { label: cat.label, color: cat.color };
});

const viewData: GraphViewData = {
  posts: viewPosts,
  links,
  legend: legendCats,
  periodBuckets,
  periodMode,
  totalPosts: posts.length,
};
---

<BaseLayout
  title="글 지도"
  description="블로그의 모든 글과 글 사이의 연관을 하나의 지도로 탐색합니다."
>
  {/* 조작하러 온 화면이라 목록·글 상세와 같은 강도 3. 데코는 **액자에만** 얹고
      지도 내용에는 손대지 않는다 — 지도는 팬·줌하므로 무언가를 가리키는 데코(시안
      1c 의 메모+화살표)는 첫 드래그에 거짓말이 된다. */}
  <section class="graph-page" data-deco="3">
    <header class="graph-header">
      {/* P-06 — 배지 없이 레터링 테이프만. 편수 배지를 빼는 이유는 커맨드 바에 이미
          라이브 카운터(글 12/29)가 있어서다: 한 화면에 편수가 둘이 되는데 저쪽만
          필터에 따라 움직인다. 인덱스 탭도 못 쓴다 — 지도 판의 MAP 탭과 한 지면에
          탭이 둘이 된다(5절 규칙 5 의 정신). */}
      <DecoHeading tape="YOU ARE HERE" rule={false} class="graph-heading">
        <h1>글 지도</h1>
      </DecoHeading>
      <p class="lead">
        글과 글 사이의 연관을 그린 지도입니다. 원 하나가 글이고, 선은 두 글이
        이어져 있다는 뜻이에요. 글에 포인터를 올리면 그 글의 연관 키워드가
        펼쳐지고, 누르면 바로 이동합니다.
      </p>
    </header>
    {
      hasGraphData ? (
        <>
          <GraphExplorer client:load data={viewData}>
            {/* P-01 — 지도 상자에 겹쳐 앉는 판. 아일랜드가 연 구멍(slot="deco")에
                들어가 inset:0 으로 펴진다. 판이 종이·테두리를 다 쥐므로 아래
                is:global 에서 svg 의 옛 껍데기를 걷어낸다(안 하면 액자가 둘). */}
            <div slot="deco" class="graph-board">
              <TapedBoard
                paper="grid"
                tone="surface"
                cell={24}
                corners="top"
                tapeA="check"
                tapeB="stripe"
                hover={false}
              >
                {/* M2 — 인덱스 탭. left 가 128px 인 건 좌상 테이프와의 다툼이다
                    (DECO_KIT 5절 규칙 8): 테이프가 -20px 에서 126px 폭이라 판
                    안쪽 106px 까지 차지한다. 문구에 편수를 안 적는 이유는 커맨드
                    바에 이미 라이브 카운터(글 12/29)가 있어서다 — 한 화면에 편수가
                    둘이 되고, 게다가 저쪽은 필터에 따라 움직이는데 이쪽은 안 움직인다.
                    hover={false} 는 규칙 9(지도는 드래그 표면). */}
                <DecoLayer
                  left="128px"
                  top="-14px"
                  rotate={-2}
                  tier={1}
                  z={4}
                  hover={false}
                >
                  <IndexTab text="MAP" tone="blue" />
                </DecoLayer>
              </TapedBoard>
            </div>

            {/* P-03 — 후보 패널은 /posts 의 PostFilter 와 **같은 역할의 필터 판**이라
                같은 처우를 준다(크림 바탕은 아래 is:global). ClippedCard 를 값만
                베끼지 않고 **빈 판으로 펴서** 쓰는 이유는 드리프트 차단이다 —
                클립의 top/rotate/tier/z 가 ClippedCard.astro 한 곳에만 남으므로
                나중에 그 파일만 고쳐도 두 지면이 갈릴 수 없다. 지도 판을 svg 뒤에
                깐 것과 같은 수법(감쌀 수 없으면 겹쳐 편다).

                **offset 이 모서리(30px)가 아니라 140px 인 건 규칙 3 때문이다.**
                클립은 판 밖으로만 나오는 게 아니라 안쪽으로도 41px 내려오는데,
                이 판의 첫 행은 양 끝이 **다 차 있다** — 왼쪽에 "기간 범위 · 월 단위"
                (x 17~119), 오른쪽에 기간·편수 읽기(x 665~847, 1280px 실측).
                /posts 가 side="right" 를 쓸 수 있는 건 그 카드의 오른쪽이 비어서지
                오른쪽이 정답이라서가 아니다(§3 "내용이 비어 있는 쪽을 골라").
                그래서 둘 사이 빈 구간에 문다: 140px 이면 상자가 132~170 이라
                라벨(~119)과 읽기(665~) 어느 쪽도 안 건드리고, 세로로도 게이지
                트랙(y 43)보다 위(y ~41)에서 끝난다. */}
            <div slot="deco-filter" class="cands-clip">
              <ClippedCard side="left" offset="140px" hover={false} />
            </div>

            {/* P-05 짜임 — 펼쳐 둔 안내 쪽지에 테이프 한 장. 오른쪽에 두는 건
                클립(왼쪽 위)과 세로로 겹치지 않게 하려는 것이다: 도움말이 열리면
                두 패널이 위아래로 붙는다. 도움말은 토글이라 이 데코의 비용은
                열릴 때만 든다. */}
            <div slot="deco-help">
              <DecoLayer
                top="-13px"
                right="44px"
                rotate={7}
                tier={3}
                z={2}
                hover={false}
              >
                <Tape variant="dot" width={96} />
              </DecoLayer>
            </div>
          </GraphExplorer>
          <noscript>
            <PostList posts={posts} />
          </noscript>
        </>
      ) : (
        <>
          <p class="empty-note">그래프 데이터가 아직 없어요. 대신 전체 글 목록을 보여드릴게요.</p>
          <PostList posts={posts} />
        </>
      )
    }
  </section>
</BaseLayout>

<style>
  .graph-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 56px var(--page-pad) 64px;
  }
  /* margin 이 0 인 건 P-06 때문이다 — DecoHeading 은 align-items:flex-end 인 flex
     행이라 감싼 h1 의 아래 마진이 그대로 행 높이가 되어 테이프 기준선이 들린다.
     /posts 가 같은 이유로 h1 { margin: 0 } 을 둔다. 원래 이 h1 이 지고 있던 10px 은
     아래 .graph-heading 으로 옮겼다. */
  .graph-header h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 5vw, 38px);
    margin: 0;
  }
  .graph-heading {
    margin-bottom: 10px;
  }
  .lead {
    font-size: 17px;
    color: var(--ink-2);
    margin: 0 0 24px;
    max-width: var(--measure);
  }
  .empty-note {
    color: var(--ink-3);
    margin: 0 0 18px;
  }

  /* ── P-01 판 ──
     구멍은 지도 상자와 같은 크기라, 판은 그 안에서 inset:0 으로 펴져 지도 **뒤에**
     깔린다(테이프만 z 로 지도 위로 올라온다). TapedBoard·PaperSurface 는 자식
     컴포넌트라 이 파일의 scoped 선택자가 안 먹으므로(Astro 는 자식 루트에 자식의
     cid 만 붙인다) 지역 조상 아래 :global 로 편다. */
  .graph-board {
    position: absolute;
    inset: 0;
  }
  .graph-board :global(.taped-board),
  .graph-board :global(.paper) {
    height: 100%;
  }

  /* ── P-03 클립 ──
     판과 같은 수법으로 편다. ClippedCard 는 슬롯을 비운 채 쓰므로 남는 건 클립
     하나뿐이고, 자리는 후보 패널과 정확히 겹친다. 클립이 top 기준이라 높이는
     사실 안 써도 맞지만, 판과 같은 규약으로 두어 다음 사람이 헷갈리지 않게 한다. */
  .cands-clip {
    position: absolute;
    inset: 0;
  }
  .cands-clip :global(.clipped-card) {
    height: 100%;
  }

  /* 좁은 화면에선 판의 테이프·탭과 **클립을 함께** 접는다(DECO_KIT 5절 규칙 6 —
     "데코는 여백에 사는데 모바일엔 여백이 없다"). 접는 이유가 둘 다 계산이다:

     · 판 테이프 — --page-pad 가 clamp(20px,5vw,48px) 라 470px 아래에서 페이지 여백이
       20px 대로 줄어드는데 좌상 테이프는 판 밖으로 ≈23px 나간다 → 가로 스크롤.
     · 클립 — 물릴 자리가 **사라진다**. 첫 행 양 끝(라벨·기간 읽기) 사이 빈 구간이
       실측으로 1280px 546 → 768px 373 → 480px 114 → **390px 32px** 로 줄어드는데
       클립 상자는 37px 다. 390px 에서는 어디에 물려도 글자를 덮는다(규칙 3).
       한 문턱으로 묶어 768px 에서 같이 접는다 — 480px 은 아직 들어가지만 문턱을
       둘로 나누면 다음 사람이 왜 갈렸는지 알 수 없다.

     도움말 테이프는 남는다 — 그쪽은 문단 위 빈 띠라 폭이 줄어도 자리가 안 사라진다.
     머리 레터링 테이프(티어 3)와 크림 바탕도 남으므로 좁은 화면이 맨몸이 되진 않는다. */
  @media (max-width: 768px) {
    .graph-board :global(.deco-layer),
    .cands-clip :global(.deco-layer) {
      display: none;
    }
  }
</style>

{/* 지도는 client:load React 아일랜드라 그 안의 CSS 는 scoped 가 아니다(React 가
    <style> 을 그대로 뱉는다). 그래서 덮어쓰기도 전역으로 내되 .graph-page 아래로
    가둔다 — posts/index.astro 가 PostFilter 의 생성 CSS 를 다루는 방식과 같다. */}
<style is:global>
  /* 액자는 이제 판이 쥔다. 걷어내지 않으면 종이 테두리 안에 옛 카드 테두리가
     한 겹 더 들어가 액자가 둘이 된다. 배경도 마찬가지 — 불투명하면 모눈이 안 비친다. */
  .graph-page .graph-explorer .graph-stage > svg {
    background: transparent;
    border: 0;
    border-radius: 0;
  }
  /* 테이프는 판 윗변에 top:-14px 로 걸치고, -10° 회전이 그 위로 10.7px 를 더 얹어
     판 밖 24.7px 까지 올라간다(실측). 후보 패널의 margin-bottom 12px 로는 모자라
     테이프가 패널 아래 모서리를 문다. **인접 형제 마진은 합쳐지지 않고 큰 쪽으로
     상쇄되므로**(12+30 이 아니라 30) 여기 값이 곧 최종 간격이다. */
  .graph-page .graph-explorer .graph-stage {
    margin-top: 30px;
  }

  /* ── 후보 패널·도움말 = 끼워 넣은 종이 ──
     후보 패널은 /posts 의 PostFilter(.pf)와 **같은 역할의 필터 판**이라 바탕도 같은
     값을 쓴다(--cream: 본문 종이 --paper 보다 한 톤 어둑). 한쪽만 크림이면 한 블로그에
     필터 판이 두 얼굴이 된다. 도움말도 같은 종이로 맞춘다 — 점선 테두리와 45° 해치는
     그대로 둔다(그 둘이 이미 "임시로 펼친 쪽지"라는 뜻이고 테이프가 그걸 완성한다). */
  .graph-page .graph-explorer .graph-cands,
  .graph-page .graph-explorer .graph-help {
    background: var(--cream);
  }
  /* 클립은 top:-19px 에 -16° 라 패널 밖 ≈21px 까지 올라가는데, 이 둘의 위 간격은
     둘 다 10px(앞 블록의 margin-bottom) 뿐이라 클립이 커맨드 바의 진한 --ink
     테두리를 문다. 지도 판에서 겪은 것과 같은 함정이고 마진 상쇄도 같다 —
     **인접 형제 마진은 합쳐지지 않고 큰 쪽으로 상쇄되므로** 여기 값이 곧 최종 간격이다.
     도움말은 닫히면 요소 자체가 없으므로 그 여백은 열릴 때만 든다. */
  .graph-page .graph-explorer .graph-cands {
    margin-top: 26px;
  }
  .graph-page .graph-explorer .graph-help {
    margin-top: 24px;
    /* 테이프가 자리를 차지하는 만큼 첫 줄을 내린다(원래 11px). 도트 테이프는
       top:-13px 에 7° 라 패널 **안쪽으로 26.7px** 내려오는데, 넓은 화면에서는 첫 줄이
       일찍 끝나 안 겹치지만 **769px 이하에서는 글이 폭을 꽉 채워 꼬리를 덮는다**
       (규칙 3 — 실측으로 잡았다: 769px 에서 27.5×14.7px 겹침).
       데코를 옮기는 대신 판을 키워 푼다 — 히어로 콜라주에서 마스코트 자리를 푼 것과
       같은 수법이고, 위로 더 밀면 이번엔 테이프가 커맨드 바를 문다. */
    padding-top: 32px;
  }
</style>
