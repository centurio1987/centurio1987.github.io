---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NavProgress from "../components/NavProgress.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  canonical?: string | URL;
  /** 푸터 배경 파도(Phase C)를 켠다. 홈(index)만 true — JS 비용을 '/' 로 가둔다. */
  ambientFooter?: boolean;
}
const {
  title,
  description = "진지함 속에서 즐거움을 찾다.",
  image = "/tony-deco.webp",
  type = "website",
  canonical = new URL(Astro.url.pathname, Astro.site),
  ambientFooter = false,
} = Astro.props;
const siteName = "빵관 토니";
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const canonicalUrl = new URL(canonical.toString(), Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* 한국어 전용 폰트 시스템. global.css 의 @import 가 아니라 여기 <link> 로 두는
        이유는 @import 가 부모 CSS 수신 완료 후에야 출발해 요청이 직렬화되기 때문이다
        (위 preconnect 는 이 <link> 와 짝이다). display=swap 이라 미도착 시 폴백으로 그린다. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Jua&family=Gowun+Dodum&family=Space+Mono:wght@400;700&family=Gaegu:wght@400;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="icon" href="/tony-face.webp" type="image/webp" />
    <link rel="apple-touch-icon" href="/tony-face.webp" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* 크로스 페이지 View Transitions. 콘텐츠는 여전히 SSR이고, 라우터 스크립트만
        전역 로드된다. Astro가 VT의 reduced-motion 을 자동 존중하며, reveal.ts 는
        astro:page-load 에 바인딩돼 VT 후 새 페이지의 [data-reveal] 을 재관측한다. */}
    <ClientRouter />
    {/* 리빌 선-부착: 모션 허용 + IO 지원일 때만 reveal-ready 를 페인트 전에 붙여
        above-the-fold 콘텐츠의 "보였다 숨는" 깜빡임을 막는다. reduced-motion/무JS/IO
        미지원이면 클래스가 없어 콘텐츠가 항상 보인다(reveal.ts 가 멱등 보강). */}
    <script is:inline>
      (function () {
        try {
          var reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          if (!reduce && "IntersectionObserver" in window) {
            document.documentElement.classList.add("reveal-ready");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <NavProgress transition:persist />
    <Header />
    <main>
      <slot />
    </main>
    <Footer ambient={ambientFooter} />
    <script>
      import { initReveal } from "../lib/motion/reveal";
      import { initNavProgress } from "../lib/motion/navProgress";
      initReveal();
      initNavProgress();
    </script>
  </body>
</html>
