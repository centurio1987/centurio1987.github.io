---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NavProgress from "../components/NavProgress.astro";
import { FEED_TITLE, FEED_URL } from "../lib/feed";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  canonical?: string | URL;
  /** 푸터 배경 파도(Phase C)를 켠다. 홈(index)만 true — JS 비용을 '/' 로 가둔다. */
  ambientFooter?: boolean;
  /** 색인에서 뺀다. 디자인 쇼케이스처럼 독자용이 아닌 내부 페이지에 쓴다. */
  noindex?: boolean;
  /**
   * 이 페이지에 **추가로** 붙일 피드 자동발견 링크 (KAN-047).
   * 전체 피드는 모든 페이지에 항상 붙으므로 여기 다시 적지 않는다 —
   * 카테고리 페이지가 자기 카테고리 피드를 얹을 때만 쓴다.
   */
  feeds?: { href: string; title: string }[];
  /**
   * 첫 화면(above-the-fold)에 큼직하게 걸리는 이미지 경로 (KAN-059).
   *
   * **딱 하나, LCP 후보만 넣는다.** 여럿 넣으면 서로 회선을 나눠 가져 결국 아무것도
   * 안 빨라진다 — preload 는 순서를 앞당기는 것이지 대역을 늘리는 게 아니다.
   *
   * 파서가 `<img>` 에 닿기 전에 요청을 띄우려는 게 아니다(프리로드 스캐너가 이미 한다).
   * **폰트보다 먼저 줄을 세우려는 것**이다: 홈은 한국어 웹폰트 3종을 쓰는데 실측에서
   * 서브셋 30여 개 ~530KB 가 VeryHigh 로 4.2초까지 회선을 물고 있었다. 그래서 이 링크는
   * 아래 폰트 스타일시트 **위**에 있어야 값을 한다 — 순서를 뒤집으면 폰트 CSS 가 먼저
   * 나가고 그 뒤로 폰트 파일이 줄줄이 붙는다.
   */
  preloadImages?: string[];
  /**
   * 이 지면의 페이지 컨테이너 폭 종류 (KAN-068).
   *
   * `"read"`(기본) = 읽는 판 `--content-max` 720px — 글 목록 · 카테고리 · 글 상세 ·
   * 폭신 대담 · 404. `"wide"` = 넓은 판 `--wide-max` 1100px — 홈 · 글 지도.
   *
   * **이 값은 셸(헤더·푸터)에만 작용한다.** 페이지 본문 컨테이너는 자기 CSS 에서 같은
   * 토큰을 직접 읽는다 — 한 화면 안에서 셸과 본문이 같은 선에 서야 하므로 **둘이 같은
   * 토큰을 가리키는지 확인하고 바꿔라.** 여기만 `"wide"` 로 두고 본문이 720px 이면
   * 고치려던 어긋남이 방향만 바뀌어 그대로 남는다.
   */
  width?: "read" | "wide";
}
const {
  title,
  description = "진지함 속에서 즐거움을 찾다.",
  image = "/tony-deco.webp",
  type = "website",
  canonical = new URL(Astro.url.pathname, Astro.site),
  ambientFooter = false,
  noindex = false,
  feeds = [],
  preloadImages = [],
  width = "read",
} = Astro.props;
const siteName = "빵관 토니";
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const canonicalUrl = new URL(canonical.toString(), Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* LCP 이미지 선점 (KAN-059) — 반드시 아래 폰트 스타일시트 **앞**에. 자세한 근거는
        preloadImages prop 주석에 있다. */}
    {
      preloadImages.map((href) => (
        <link rel="preload" as="image" href={href} fetchpriority="high" />
      ))
    }
    {/* 한국어 전용 폰트 시스템. global.css 의 @import 가 아니라 여기 <link> 로 두는
        이유는 @import 가 부모 CSS 수신 완료 후에야 출발해 요청이 직렬화되기 때문이다
        (위 preconnect 는 이 <link> 와 짝이다). display=swap 이라 미도착 시 폴백으로 그린다.

        **Gowun Dodum 이 여기 없는 것이 정상이다** (KAN-080 S7) — 본문 서체만 자체 호스팅으로
        옮겼고 @font-face 는 global.css 에 있다. 구글에는 400 한 종뿐이라 §5 가 규정한 700 을
        받을 길이 없었고, 그 굵기는 여태 브라우저 합성이었다. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Jua&family=Space+Mono:wght@400;700&family=Gaegu:wght@400;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="icon" href="/tony-face.webp" type="image/webp" />
    <link rel="apple-touch-icon" href="/tony-face.webp" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* 피드 자동발견 (KAN-047). 리더 확장·브라우저가 주소만 보고 구독을 걸 수 있게
        모든 페이지에 전체 피드를 깐다. 카테고리 페이지는 자기 피드를 추가로 얹는다 —
        전체 피드를 **먼저** 두는 순서가 곧 기본 선택이다(리더 대부분이 첫 항목을 고른다). */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={FEED_TITLE}
      href={new URL(FEED_URL, Astro.site).href}
    />
    {
      feeds.map((f) => (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={f.title}
          href={new URL(f.href, Astro.site).href}
        />
      ))
    }
    {/* 크로스 페이지 View Transitions. 콘텐츠는 여전히 SSR이고, 라우터 스크립트만
        전역 로드된다. Astro가 VT의 reduced-motion 을 자동 존중하며, reveal.ts 는
        astro:page-load 에 바인딩돼 VT 후 새 페이지의 [data-reveal] 을 재관측한다. */}
    <ClientRouter />
    {/* 리빌 선-부착: 모션 허용 + IO 지원일 때만 reveal-ready 를 페인트 전에 붙여
        above-the-fold 콘텐츠의 "보였다 숨는" 깜빡임을 막는다. reduced-motion/무JS/IO
        미지원이면 클래스가 없어 콘텐츠가 항상 보인다(reveal.ts 가 멱등 보강). */}
    <script is:inline>
      (function () {
        try {
          var reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          if (!reduce && "IntersectionObserver" in window) {
            document.documentElement.classList.add("reveal-ready");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={width === "wide" ? "shell-wide" : undefined}>
    <NavProgress transition:persist />
    <Header />
    <main>
      <slot />
    </main>
    <Footer ambient={ambientFooter} />
    {/* 이미지 도착 대기 (KAN-059). 계약과 근거는 styles/motion.css 의 "이미지 도착 대기" 절.
        **모듈이 아니라 `is:inline` 인 이유**: `<script>`(type=module)는 defer 라 첫 페인트
        뒤에 돌 수 있다. 그러면 데코가 한 번 그려졌다가 사라졌다 다시 나타나는 깜빡임이
        생긴다. 파서를 잡는 인라인 스크립트만이 "페인트 전에 반드시" 를 보장하고, 게다가
        네트워크 의존이 없어 번들이 늦어도 판이 빈 채로 남지 않는다(head 의 reveal-ready
        선-부착 스크립트가 인라인인 것과 같은 이유). */}
    <script is:inline>
      (function () {
        var READY = "data-imgready";
        var mark = function (el) {
          el.setAttribute(READY, "");
        };
        function arm() {
          try {
            // ⚠ 여기서 reveal-ready 를 보고 일찍 빠지면 안 된다 — 원래 "클래스가 없으면
            // CSS 가 아무것도 안 숨기니 할 일도 없다"는 최적화였는데, VT 와 경합한다.
            // 스왑은 <html> 의 class 를 **새 문서 것으로 갈아치우므로** reveal-ready 가
            // 잠깐 사라지고, page-load 직후 head 인라인이 다시 붙인다. 그 틈에 이 함수가
            // 빠져나가면 곧바로 클래스가 붙어 CSS 가 판을 숨기는데 표시할 사람은 이미 없다
            // → 사진이 영영 opacity 0 (실측 트레이스: page-load(reveal=false) 18ms 뒤에
            // html.class→reveal-ready. 아래 3초 방어선도 등록 전이라 안 걸려서, 같은 지면을
            // 두 번째로 밟는 순간부터 4/4 가 0/4 로 굳었다).
            // data-imgready 는 클래스가 없을 때 붙어도 무해하므로 언제나 진행한다 —
            // reveal.ts 가 같은 자리에서 reveal-ready 를 스스로 붙이고 진행하는 것과 대칭이다.
            var pending = document.querySelectorAll(
              "[data-imgwait]:not([" + READY + "])",
            );
            Array.prototype.forEach.call(pending, function (el) {
              // 표식이 img 자신이면 그것, 판이면 판 안의 첫 그림이 기준이다.
              var img = el.tagName === "IMG" ? el : el.querySelector("img");
              if (!img || (img.complete && img.naturalWidth > 0)) {
                mark(el);
                return;
              }
              var done = function () {
                mark(el);
              };
              img.addEventListener("load", done, { once: true });
              // error 도 표시다 — 404·오프라인에 판을 영영 감추면 안 된다.
              img.addEventListener("error", done, { once: true });
            });
            // 상한. load/error 가 둘 다 안 오는 경우(디코드 실패 등)의 마지막 방어선.
            setTimeout(function () {
              Array.prototype.forEach.call(
                document.querySelectorAll("[data-imgwait]:not([" + READY + "])"),
                mark,
              );
            }, 3000);
          } catch (e) {
            // 예외 시 콘텐츠 절대 숨기지 않음(리빌 계약과 같은 원칙).
            Array.prototype.forEach.call(
              document.querySelectorAll("[data-imgwait]"),
              mark,
            );
          }
        }
        arm();
        if (!window.__imgWaitBound) {
          window.__imgWaitBound = true;
          document.addEventListener("astro:page-load", arm);
        }
      })();
    </script>
    <script>
      import { initReveal } from "../lib/motion/reveal";
      import { initNavProgress } from "../lib/motion/navProgress";
      initReveal();
      initNavProgress();
    </script>
  </body>
</html>
