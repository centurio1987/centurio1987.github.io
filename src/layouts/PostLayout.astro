---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "./BaseLayout.astro";
import CategoryBadge from "../components/CategoryBadge.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import AuthorProfile from "../components/AuthorProfile.astro";
import AiBanner from "../components/AiBanner.astro";
import PostNav from "../components/PostNav.astro";
import SeriesEpisodes from "../components/SeriesEpisodes.astro";
import PostToc from "../components/PostToc.astro";
import Squiggle from "../components/motifs/Squiggle.astro";
import TicketStub from "../components/deco/TicketStub.astro";
import Stamp from "../components/deco/Stamp.astro";
import { formatDate, readingTime } from "../lib/format";
import { getAuthor } from "../lib/authors";
import { getRelatedPosts } from "../lib/related";
import { getSeriesPosts, episodeNumber } from "../lib/seriesNav";
import { getCollection, type CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
// 데코 키트는 opt-in — 인용(P-04) · 코드블록(P-05) · 시리즈 꼬리말(P-08)이 여기 살아서
// 이 레이아웃이 토큰·강도 게이트를 지고 온다. TalkLayout 은 들여오지 않는다.
import "../styles/deco.css";

interface Props {
  post: CollectionEntry<"posts">;
  /** render(post) 의 headings — 우측 목차 레일(PostToc)의 원본. */
  headings: MarkdownHeading[];
}
const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, category } = post.data;
const author = getAuthor(post.data.author);
const minutes = readingTime(post.body);
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const related = getRelatedPosts(post, allPosts);

// ── P-08 시리즈 꼬리말 ──
// 티켓 스텁은 값이 **둘**일 때 쓰는 부품이라 (이 회차, 전체 편수) 짝을 넣는다.
// 완결 도장은 마지막 편에만 — 매 편 찍으면 "여기서 끝"이라는 뜻이 사라진다.
const seriesPosts = getSeriesPosts(post, allPosts);
const seriesEp = seriesPosts.length > 1 ? episodeNumber(post, seriesPosts) : null;
const isSeriesEnd =
  seriesEp != null && seriesPosts[seriesPosts.length - 1].id === post.id;

const slug = post.id.replace(/\.(md|mdx)$/, "");
let postImage = "/tony-deco.webp";
const heroPath = path.join(process.cwd(), "public", "images", slug, "hero.webp");
if (fs.existsSync(heroPath)) {
  postImage = `/images/${slug}/hero.webp`;
} else {
  const imgDir = path.join(process.cwd(), "public", "images", slug);
  if (fs.existsSync(imgDir)) {
    // readdir 순서는 명세되지 않아 런타임(node/bun)마다 갈린다 — 이름순으로 고정한다.
    // 로캘(ICU)에 의존하는 localeCompare 대신 코드포인트 비교를 쓴다.
    // 같은 디렉터리의 이미지가 하위 디렉터리보다 우선한다.
    const findFirstImage = (dir: string): string | null => {
      const entries = fs
        .readdirSync(dir, { withFileTypes: true })
        .sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));
      for (const entry of entries) {
        if (!entry.isDirectory() && /\.(webp|png|jpg|jpeg)$/i.test(entry.name)) {
          return path.join(dir, entry.name);
        }
      }
      for (const entry of entries) {
        if (entry.isDirectory()) {
          const found = findFirstImage(path.join(dir, entry.name));
          if (found) return found;
        }
      }
      return null;
    };
    const found = findFirstImage(imgDir);
    if (found) {
      postImage = "/" + path.relative(path.join(process.cwd(), "public"), found).replace(/\\/g, "/");
    }
  }
}
---

<BaseLayout title={title} description={description} image={postImage} type="article">
  {/* 읽는 화면이라 강도 3(은근하게) — 인용 테이프·코드 테이프까지만 보이고
      잉여 장식(티어 4)은 접힌다. DECO_KIT 2절. */}
  <article class="post" data-deco="3">
    {
      author.isAI && author.banner && (
        <AiBanner
          src={author.banner}
          alt={author.bannerAlt ?? `${author.name} 퍼소나가 집필했습니다`}
        />
      )
    }
    <header class="post-header">
      <div class="post-meta">
        <CategoryBadge category={category} asLink />
        <span class="dot">·</span>
        <span class="post-author">{author.name}</span>
        <span class="dot">·</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span class="dot">·</span>
        <span>{minutes}분</span>
      </div>
      <h1 transition:name={`post-${slug}-title`}>{title}</h1>
      {description && <p class="lead">{description}</p>}
      <Squiggle class="post-rule" />
    </header>
    <PostToc headings={headings} />
    <div class="prose">
      <slot />
    </div>
    {
      updatedDate && (
        <p class="updated">마지막 수정: {formatDate(updatedDate)}</p>
      )
    }
    <PostNav post={post} allPosts={allPosts} />
    <SeriesEpisodes post={post} allPosts={allPosts} />
    {
      seriesEp != null && (
        /* P-08 — 티켓 + 손글씨 (+ 마지막 편이면 완결 도장).
           티켓 문구는 PostNav·SeriesEpisodes 가 이미 읽어주는 값이라 장식으로 두고,
           읽히는 건 손글씨 한 줄이다. */
        <div class="series-foot">
          <span class="foot-ticket">
            <TicketStub
              code={`EP ${String(seriesEp).padStart(2, "0")}`}
              note={`총 ${seriesPosts.length}편`}
              notch="var(--paper)"
            />
          </span>
          <p class="foot-hand">
            {isSeriesEnd
              ? "시리즈 끝! 여기까지 읽어주셔서 고마워요 ♡"
              : "여기까지가 이번 편. 다음 편에서 이어집니다."}
          </p>
          {isSeriesEnd && (
            <span class="foot-stamp" aria-hidden="true">
              <Stamp variant="round" text="BAKED" sub="빵관토니" size={58} />
            </span>
          )}
        </div>
      )
    }
    <div class="post-author-card">
      <AuthorProfile authorId={author.id} />
    </div>
    <RelatedPosts items={related} />
  </article>
</BaseLayout>

<style>
  /* ── POST HEADER ENTRANCE ANIMATION ── */
  @keyframes fadeUp {
    from { opacity: 0; translate: 0 12px; }
    to   { opacity: 1; translate: 0 0;    }
  }
  .post-meta {
    animation: fadeUp 240ms var(--ease) both;
    animation-delay: 0ms;
  }
  .post-header h1 {
    animation: fadeUp 240ms var(--ease) both;
    animation-delay: 60ms;
  }
  .lead {
    animation: fadeUp 240ms var(--ease) both;
    animation-delay: 120ms;
  }

  .post {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 56px var(--page-pad) 0;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    color: var(--ink-3);
    font-weight: 500;
  }
  .post-header h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 5vw, 38px);
    margin: 16px 0 10px;
  }
  .lead {
    font-size: 19px;
    color: var(--ink-2);
    margin: 0 0 18px;
  }
  .post-rule {
    margin: 8px 0 4px;
  }
  .updated {
    margin-top: 48px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .post-author-card {
    margin-top: 56px;
  }

  /* ── P-08 시리즈 꼬리말 ── */
  .series-foot {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 34px;
    padding-top: 22px;
    border-top: 1px dashed var(--border);
  }
  /* 손으로 얹은 티가 나게 살짝 기운다 — 각도는 -12°~12° 안(DECO_KIT 5절 규칙 7) */
  .foot-ticket {
    display: inline-flex;
    transform: rotate(-1.5deg);
  }
  .foot-hand {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 20px;
    color: var(--ink-3);
  }
  .foot-stamp {
    display: inline-flex;
    flex: none;
    transform: rotate(-12deg);
  }
</style>

<style is:global>
  .prose {
    font-size: 18px;
    line-height: 1.8;
    /* 안전망: 공백 없는 초장문 인라인 런(예: `·`로 이어 붙인 코드 나열)이
       줄바꿈 기회를 못 찾아 페이지 가로 스크롤을 만드는 것을 막는다. 일반
       한글/영문은 공백에서 먼저 끊기므로 영향 없고, white-space:pre 인 <pre>
       코드블록도 래핑을 안 하므로 그대로 내부 가로 스크롤을 유지한다. */
    overflow-wrap: break-word;
  }
  .prose > * {
    max-width: var(--measure);
  }
  .prose h2 {
    font-family: var(--font-body);
    font-size: 26px;
    font-weight: 700;
    margin: 48px 0 14px;
  }
  /* 목차·해시 링크로 점프했을 때 sticky 헤더가 제목을 덮지 않게 한다.
     --header-h 는 tokens.css 의 실측 폴백이고, tocSpy 가 뜨면 실제 헤더 높이로 갱신된다. */
  .prose :is(h2, h3) {
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .prose h3 {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 700;
    margin: 36px 0 10px;
  }
  .prose p,
  .prose ul,
  .prose ol {
    margin: 16px 0;
  }
  /* 인용의 틀은 P-04(TapedQuote)와 같은 얼굴로 맞춘다.
   *
   * 데코를 얹는 통로인 MDX `components` 매핑은 **.mdx 에만 먹는다** — 순수 마크다운
   * (.md) 글 3편(algorithm-at-40-prologue · aside-arc · welcome)은 ProseQuote 를
   * 거치지 않고 이 규칙으로 그려진다. 그래서 여기를 예전 모습(코발트 선 + surface
   * 바탕)으로 두면 같은 블로그 안에 인용이 두 얼굴이 된다.
   *
   * 틀(분홍 세로선 · 바탕 없음 · 큰 글씨)은 여기서 맞추고, **테이프만** 데코로
   * 남긴다 — 즉 .md 글은 "테이프 안 붙은 같은 인용"이지 다른 디자인이 아니다.
   * 타이포 값은 TapedQuote 의 blockquote 규칙과 같게 유지한다(둘이 갈리면 이 의도가
   * 깨진다). 감싼 .taped-quote 쪽 규칙은 cid 덕에 특이도가 높아 이걸 덮어쓴다. */
  .prose blockquote {
    margin: 34px 0;
    padding: 6px 0 6px 22px;
    border-left: 3px solid var(--deco-pink);
    background: none;
    border-radius: 0;
    font-size: 19px;
    font-weight: 500;
    line-height: 1.8;
    color: var(--ink);
  }
  .prose img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 24px auto;
  }

  /* ── 데코: 테이프는 글마다 한 장씩만 ────────────────────────────────────────
   * 마크다운의 인용·코드블록은 ProseQuote·ProseCode 어댑터를 거쳐 패턴 P-04·P-05 로
   * 그려진다. 그런데 인용이 11개(container-anatomy-3), 코드블록이 42개(tauri-2)인
   * 글이 있어서 전부 테이프를 붙이면 테이프가 "붙인 것"이 아니라 인용·코드의 기본
   * 장식으로 읽힌다 — 도장을 한 항목에만 찍는 이유(DECO_KIT 5절 규칙 4)와 같다.
   *
   * 그래서 **먼저 나온 형제 뒤로는 테이프를 접는다**. 세는 주체가 CSS 라서 렌더 순서
   * 같은 것에 기대지 않고, 글 파일도 안 건드린다. 선택자 끝을 span.deco-layer 로
   * 두는 건 DecoLayer 의 티어 게이트(.deco-layer.t3{display:var(--deco-t3)})와
   * 특이도가 같아지는 걸 피하려는 것이다(타입 선택자 하나로 이긴다).
   *
   * 인용·코드가 목록/인용 안에 중첩되면 부모가 달라 각자 첫 장을 갖는다 — 드물고,
   * 그 경우엔 오히려 그 블록이 따로 붙은 것으로 읽혀 문제되지 않는다. */
  .prose .taped-quote ~ .taped-quote span.deco-layer,
  .prose .taped-code ~ .taped-code span.deco-layer {
    display: none;
  }
</style>
