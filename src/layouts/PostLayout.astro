---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "./BaseLayout.astro";
import CategoryBadge from "../components/CategoryBadge.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import AuthorProfile from "../components/AuthorProfile.astro";
import AiBanner from "../components/AiBanner.astro";
import PostNav from "../components/PostNav.astro";
import SeriesEpisodes from "../components/SeriesEpisodes.astro";
import PostToc from "../components/PostToc.astro";
import Squiggle from "../components/motifs/Squiggle.astro";
import TicketStub from "../components/deco/TicketStub.astro";
import Stamp from "../components/deco/Stamp.astro";
import { formatDate, readingTime } from "../lib/format";
import { getAuthor } from "../lib/authors";
import { getRelatedPosts } from "../lib/related";
import { getSeriesPosts, episodeNumber } from "../lib/seriesNav";
import { getCollection, type CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
// 데코 키트는 opt-in — 인용(P-04) · 코드블록(P-05) · 시리즈 꼬리말(P-08)이 여기 살아서
// 이 레이아웃이 토큰·강도 게이트를 지고 온다. TalkLayout 은 들여오지 않는다.
import "../styles/deco.css";

interface Props {
  post: CollectionEntry<"posts">;
  /** render(post) 의 headings — 우측 목차 레일(PostToc)의 원본. */
  headings: MarkdownHeading[];
}
const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, category } = post.data;
const author = getAuthor(post.data.author);
const minutes = readingTime(post.body);
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const related = getRelatedPosts(post, allPosts);

// ── P-08 시리즈 꼬리말 ──
// 티켓 스텁은 값이 **둘**일 때 쓰는 부품이라 (이 회차, 전체 편수) 짝을 넣는다.
// 완결 도장은 마지막 편에만 — 매 편 찍으면 "여기서 끝"이라는 뜻이 사라진다.
const seriesPosts = getSeriesPosts(post, allPosts);
const seriesEp = seriesPosts.length > 1 ? episodeNumber(post, seriesPosts) : null;
const isSeriesEnd =
  seriesEp != null && seriesPosts[seriesPosts.length - 1].id === post.id;

const slug = post.id.replace(/\.(md|mdx)$/, "");
let postImage = "/tony-deco.webp";
const heroPath = path.join(process.cwd(), "public", "images", slug, "hero.webp");
if (fs.existsSync(heroPath)) {
  postImage = `/images/${slug}/hero.webp`;
} else {
  const imgDir = path.join(process.cwd(), "public", "images", slug);
  if (fs.existsSync(imgDir)) {
    // readdir 순서는 명세되지 않아 런타임(node/bun)마다 갈린다 — 이름순으로 고정한다.
    // 로캘(ICU)에 의존하는 localeCompare 대신 코드포인트 비교를 쓴다.
    // 같은 디렉터리의 이미지가 하위 디렉터리보다 우선한다.
    const findFirstImage = (dir: string): string | null => {
      const entries = fs
        .readdirSync(dir, { withFileTypes: true })
        .sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));
      for (const entry of entries) {
        if (!entry.isDirectory() && /\.(webp|png|jpg|jpeg)$/i.test(entry.name)) {
          return path.join(dir, entry.name);
        }
      }
      for (const entry of entries) {
        if (entry.isDirectory()) {
          const found = findFirstImage(path.join(dir, entry.name));
          if (found) return found;
        }
      }
      return null;
    };
    const found = findFirstImage(imgDir);
    if (found) {
      postImage = "/" + path.relative(path.join(process.cwd(), "public"), found).replace(/\\/g, "/");
    }
  }
}
---

<BaseLayout title={title} description={description} image={postImage} type="article">
  {/* 읽는 화면이라 강도 3(은근하게) — 인용 테이프·코드 테이프까지만 보이고
      잉여 장식(티어 4)은 접힌다. DECO_KIT 2절. */}
  <article class="post" data-deco="3">
    {
      author.isAI && author.banner && (
        <AiBanner
          src={author.banner}
          alt={author.bannerAlt ?? `${author.name} 퍼소나가 집필했습니다`}
        />
      )
    }
    <header class="post-header">
      <div class="post-meta">
        <CategoryBadge category={category} asLink />
        <span class="dot">·</span>
        <span class="post-author">{author.name}</span>
        <span class="dot">·</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span class="dot">·</span>
        <span>{minutes}분</span>
      </div>
      <h1 transition:name={`post-${slug}-title`}>{title}</h1>
      {description && <p class="lead">{description}</p>}
      <Squiggle class="post-rule" />
    </header>
    <PostToc headings={headings} />
    <div class="prose">
      <slot />
    </div>
    {
      updatedDate && (
        <p class="updated">마지막 수정: {formatDate(updatedDate)}</p>
      )
    }
    <PostNav post={post} allPosts={allPosts} />
    <SeriesEpisodes post={post} allPosts={allPosts} />
    {
      seriesEp != null && (
        /* P-08 — 티켓 + 손글씨 (+ 마지막 편이면 완결 도장).
           티켓 문구는 PostNav·SeriesEpisodes 가 이미 읽어주는 값이라 장식으로 두고,
           읽히는 건 손글씨 한 줄이다. */
        <div class="series-foot">
          <span class="foot-ticket">
            <TicketStub
              code={`EP ${String(seriesEp).padStart(2, "0")}`}
              note={`총 ${seriesPosts.length}편`}
              notch="var(--paper)"
            />
          </span>
          <p class="foot-hand">
            {isSeriesEnd
              ? "시리즈 끝! 여기까지 읽어주셔서 고마워요 ♡"
              : "여기까지가 이번 편. 다음 편에서 이어집니다."}
          </p>
          {isSeriesEnd && (
            <span class="foot-stamp" aria-hidden="true">
              <Stamp variant="round" text="BAKED" sub="빵관토니" size={58} />
            </span>
          )}
        </div>
      )
    }
    <div class="post-author-card">
      <AuthorProfile authorId={author.id} />
    </div>
    <RelatedPosts items={related} />
  </article>
</BaseLayout>

<style>
  /* ── POST HEADER ENTRANCE ANIMATION ── */
  @keyframes fadeUp {
    from { opacity: 0; translate: 0 12px; }
    to   { opacity: 1; translate: 0 0;    }
  }
  .post-meta {
    animation: fadeUp 240ms var(--ease) both;
    animation-delay: 0ms;
  }
  .post-header h1 {
    animation: fadeUp 240ms var(--ease) both;
    animation-delay: 60ms;
  }
  .lead {
    animation: fadeUp 240ms var(--ease) both;
    animation-delay: 120ms;
  }

  .post {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 56px var(--page-pad) 0;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    color: var(--ink-3);
    font-weight: 500;
  }
  .post-header h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 5vw, 38px);
    margin: 16px 0 10px;
  }
  .lead {
    font-size: 19px;
    color: var(--ink-2);
    margin: 0 0 18px;
  }
  .post-rule {
    margin: 8px 0 4px;
  }
  .updated {
    margin-top: 48px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .post-author-card {
    margin-top: 56px;
  }

  /* ── P-08 시리즈 꼬리말 ── */
  .series-foot {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 34px;
    padding-top: 22px;
    border-top: 1px dashed var(--border);
  }
  /* 손으로 얹은 티가 나게 살짝 기운다 — 각도는 -12°~12° 안(DECO_KIT 5절 규칙 7) */
  .foot-ticket {
    display: inline-flex;
    transform: rotate(-1.5deg);
  }
  .foot-hand {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 20px;
    color: var(--ink-3);
  }
  .foot-stamp {
    display: inline-flex;
    flex: none;
    transform: rotate(-12deg);
  }
</style>

<style is:global>
  .prose {
    font-size: 18px;
    line-height: 1.8;
    /* 안전망: 공백 없는 초장문 인라인 런(예: `·`로 이어 붙인 코드 나열)이
       줄바꿈 기회를 못 찾아 페이지 가로 스크롤을 만드는 것을 막는다. 일반
       한글/영문은 공백에서 먼저 끊기므로 영향 없고, white-space:pre 인 <pre>
       코드블록도 래핑을 안 하므로 그대로 내부 가로 스크롤을 유지한다. */
    overflow-wrap: break-word;
  }
  .prose > * {
    max-width: var(--measure);
  }
  .prose h2 {
    font-family: var(--font-body);
    font-size: 26px;
    font-weight: 700;
    margin: 48px 0 14px;
  }
  /* 목차·해시 링크로 점프했을 때 sticky 헤더가 제목을 덮지 않게 한다.
     --header-h 는 tokens.css 의 실측 폴백이고, tocSpy 가 뜨면 실제 헤더 높이로 갱신된다. */
  .prose :is(h2, h3) {
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .prose h3 {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 700;
    margin: 36px 0 10px;
  }
  .prose p,
  .prose ul,
  .prose ol {
    margin: 16px 0;
  }
  /* 인용의 틀은 P-04(MarkedQuote)와 같은 얼굴로 맞춘다.
   *
   * 데코를 얹는 통로인 MDX `components` 매핑은 **.mdx 에만 먹는다.** 예전에는 순수
   * 마크다운(.md) 글 3편이 ProseQuote 를 안 거쳐 이 규칙으로만 그려졌고, 그래서 이
   * 자리에 "틀은 같고 테이프만 없는 인용"이라는 타협이 적혀 있었다. **그 타협이
   * 곧 일관성 결함이었다** — 데코가 붙은 인용과 안 붙은 인용이 갈리는 것을 없애라는
   * 지시를 받고 세 편을 `.mdx` 로 옮겼다(글자는 안 고쳤고, `.md` 에서 문자열이던
   * `style=` 속성 하나만 JSX 객체로 바꿨다). 이제 컬렉션 전체가 `.mdx` 라 모든
   * 인용이 어댑터를 지난다.
   *
   * 그래도 이 규칙은 남긴다 — 중첩 인용·미래의 예외에 대한 바닥값이고, 타이포 값은
   * MarkedQuote 의 blockquote 규칙과 같게 유지한다(둘이 갈리면 인용이 두 얼굴이
   * 된다). 감싼 .marked-quote 쪽 규칙은 cid 덕에 특이도가 높아 이걸 덮어쓴다. */
  .prose blockquote {
    margin: 34px 0;
    padding: 6px 0 6px 22px;
    border-left: 3px solid var(--deco-pink);
    background: none;
    border-radius: 0;
    font-size: 19px;
    font-weight: 500;
    line-height: 1.8;
    color: var(--ink);
  }
  /* 인용 안의 첫·끝 문단은 자기 바깥 여백을 버린다.
   *
   * 인용이 여러 문단이면 `.prose p` 의 16px 이 인용 상자 **안쪽 위아래**에
   * 얹혀서, 분홍 세로선이 글자보다 22px 씩 길어진다(실측: aside-arc 의 두 문단
   * 인용 — 위 22px · 아래 22px, 한 문단짜리는 6px). 그러면 문단을 나눌수록 인용이
   * 헐거워져서, **문단을 나누는 게 손해가 되는** 상태가 된다. 실제로 발행 글의
   * 긴 인용은 죄다 한 문단으로 붙어 있었다(아래 게이트가 잡는 것).
   *
   * 문단 사이 16px 은 그대로 둔다 — 없애야 할 건 상자와 글자 사이의 빈 띠뿐이다.
   * MarkedQuote 의 scoped CSS 로는 안 걸려서 여기 전역 블록에 둔다 — 슬롯으로
   * 들어온 `<p>` 에는 그 컴포넌트의 cid 가 안 붙는다. */
  .prose blockquote > :first-child {
    margin-top: 0;
  }
  .prose blockquote > :last-child {
    margin-bottom: 0;
  }
  .prose img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 24px auto;
  }

  /* ── 데코: 인용·코드에는 예외 없이 붙는다 ───────────────────────────────────
   * 여기 있던 "글마다 첫 하나에만" 규칙을 **걷어냈다**(유저 지시). 사연을 남기는
   * 이유는 걷어낸 자리에 같은 규칙이 다시 자라기 쉬워서다.
   *
   * 처음 사유는 절제였다 — 인용 11개(container-anatomy-3) · 코드블록 42개(tauri-2)
   * 짜리 글이 있어서, 전부 붙이면 테이프가 "붙인 것"이 아니라 기본 장식으로 읽힌다는
   * 것(도장을 한 항목에만 찍는 이유와 같다). 그 값이 실제 지면에서는 반대로 나왔다:
   * 읽는 쪽에는 "첫 하나"라는 규칙이 안 보이고 **붙은 것과 안 붙은 것이 뒤섞인
   * 화면**만 보인다. 같은 지적을 두 번 받고서야 뒤집었다.
   *
   * 그 사이에 이 규칙은 **자기 방식으로 한 번 더 고장났다.** `~`(형제 결합자)는
   * 같은 부모 안에서만 세므로 `<li>` 안의 코드블록이 자기 부모의 첫 장이 되어,
   * 발행 글 전수에서 아홉 편에 43장이 샜다. 그때는 선택자를 하나 더 얹어 막았지만
   * (`.prose > * :is(…)`), **막을수록 "왜 여기만 있나"가 늘어나는 규칙**이었다.
   *
   * 지금은 규칙이 없다 — 인용에는 두들 하트(P-04), 코드블록에는 두번 체크 마크
   * (P-05)가 하나도 빠짐없이 붙는다. 세는 CSS 가 사라졌으니 중첩·순서·컨테이너
   * 종류를 따질 일도 함께 사라졌다. 전수 검증은 `scripts/verify-deco.ts` 의 마지막
   * 절이 "인용 수 == 하트 수 · 코드 수 == 두번체크 수"로 본다.
   *
   * **테이프는 둘 다에서 빠졌다** — 인용이 하트로 갈아탄 뒤 코드만 테이프로 남으니
   * 한 지면에 손이 둘이 됐다. 지금 반복 요소에 얹히는 건 전부 두들 마크 하나씩이고,
   * 테이프는 판을 붙잡는 자리(히어로 콜라주·글 지도)에만 남는다. */
</style>
