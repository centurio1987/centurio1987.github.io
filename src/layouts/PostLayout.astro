---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "./BaseLayout.astro";
import CategoryBadge from "../components/CategoryBadge.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import AuthorProfile from "../components/AuthorProfile.astro";
import AiBanner from "../components/AiBanner.astro";
import PostNav from "../components/PostNav.astro";
import SeriesEpisodes from "../components/SeriesEpisodes.astro";
import Squiggle from "../components/motifs/Squiggle.astro";
import { formatDate, readingTime } from "../lib/format";
import { getAuthor } from "../lib/authors";
import { getRelatedPosts } from "../lib/related";
import { getCollection, type CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category } = post.data;
const author = getAuthor(post.data.author);
const minutes = readingTime(post.body);
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const related = getRelatedPosts(post, allPosts);

const slug = post.id.replace(/\.(md|mdx)$/, "");
let postImage = "/images/tony-deco.webp";
const heroPath = path.join(process.cwd(), "public", "images", slug, "hero.webp");
if (fs.existsSync(heroPath)) {
  postImage = `/images/${slug}/hero.webp`;
} else {
  const imgDir = path.join(process.cwd(), "public", "images", slug);
  if (fs.existsSync(imgDir)) {
    const findFirstImage = (dir: string): string | null => {
      for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
        if (entry.isDirectory()) {
          const found = findFirstImage(path.join(dir, entry.name));
          if (found) return found;
        } else if (/\.(webp|png|jpg|jpeg)$/i.test(entry.name)) {
          return path.join(dir, entry.name);
        }
      }
      return null;
    };
    const found = findFirstImage(imgDir);
    if (found) {
      postImage = "/" + path.relative(path.join(process.cwd(), "public"), found).replace(/\\/g, "/");
    }
  }
}
---

<BaseLayout title={title} description={description} image={postImage} type="article">
  <article class="post">
    {
      author.isAI && author.banner && (
        <AiBanner
          src={author.banner}
          alt={author.bannerAlt ?? `${author.name} 퍼소나가 집필했습니다`}
        />
      )
    }
    <header class="post-header">
      <div class="post-meta">
        <CategoryBadge category={category} asLink />
        <span class="dot">·</span>
        <span class="post-author">{author.name}</span>
        <span class="dot">·</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span class="dot">·</span>
        <span>{minutes}분</span>
      </div>
      <h1>{title}</h1>
      {description && <p class="lead">{description}</p>}
      <Squiggle class="post-rule" />
    </header>
    <div class="prose">
      <slot />
    </div>
    {
      updatedDate && (
        <p class="updated">마지막 수정: {formatDate(updatedDate)}</p>
      )
    }
    <PostNav post={post} allPosts={allPosts} />
    <SeriesEpisodes post={post} allPosts={allPosts} />
    <div class="post-author-card">
      <AuthorProfile authorId={author.id} />
    </div>
    <RelatedPosts items={related} />
  </article>
</BaseLayout>

<style>
  /* ── POST HEADER ENTRANCE ANIMATION ── */
  @keyframes fadeUp {
    from { opacity: 0; translate: 0 12px; }
    to   { opacity: 1; translate: 0 0;    }
  }
  .post-meta {
    animation: fadeUp 240ms var(--ease) both;
    animation-delay: 0ms;
  }
  .post-header h1 {
    animation: fadeUp 240ms var(--ease) both;
    animation-delay: 60ms;
  }
  .lead {
    animation: fadeUp 240ms var(--ease) both;
    animation-delay: 120ms;
  }

  .post {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 56px var(--page-pad) 0;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    color: var(--ink-3);
    font-weight: 500;
  }
  .post-header h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 5vw, 38px);
    margin: 16px 0 10px;
  }
  .lead {
    font-size: 19px;
    color: var(--ink-2);
    margin: 0 0 18px;
  }
  .post-rule {
    margin: 8px 0 4px;
  }
  .updated {
    margin-top: 48px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .post-author-card {
    margin-top: 56px;
  }
</style>

<style is:global>
  .prose {
    font-size: 18px;
    line-height: 1.8;
  }
  .prose > * {
    max-width: var(--measure);
  }
  .prose h2 {
    font-family: var(--font-body);
    font-size: 26px;
    font-weight: 700;
    margin: 48px 0 14px;
  }
  .prose h3 {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 700;
    margin: 36px 0 10px;
  }
  .prose p,
  .prose ul,
  .prose ol {
    margin: 16px 0;
  }
  .prose blockquote {
    margin: 24px 0;
    padding: 8px 18px;
    border-left: 3px solid var(--accent);
    background: var(--surface);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--ink-2);
  }
  .prose img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 24px auto;
  }
</style>
