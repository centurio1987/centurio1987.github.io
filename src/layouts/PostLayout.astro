---
import BaseLayout from "./BaseLayout.astro";
import CategoryBadge from "../components/CategoryBadge.astro";
import Squiggle from "../components/motifs/Squiggle.astro";
import { formatDate, readingTime } from "../lib/format";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category } = post.data;
const minutes = readingTime(post.body);
---

<BaseLayout title={title} description={description}>
  <article class="post">
    <header class="post-header">
      <div class="post-meta">
        <CategoryBadge category={category} asLink />
        <span class="dot">·</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span class="dot">·</span>
        <span>{minutes}분</span>
      </div>
      <h1>{title}</h1>
      {description && <p class="lead">{description}</p>}
      <Squiggle class="post-rule" />
    </header>
    <div class="prose">
      <slot />
    </div>
    {
      updatedDate && (
        <p class="updated">마지막 수정: {formatDate(updatedDate)}</p>
      )
    }
  </article>
</BaseLayout>

<style>
  .post {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 56px var(--page-pad) 0;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    color: var(--ink-3);
    font-weight: 500;
  }
  .post-header h1 {
    font-size: clamp(28px, 5vw, 38px);
    margin: 16px 0 10px;
  }
  .lead {
    font-size: 19px;
    color: var(--ink-2);
    margin: 0 0 18px;
  }
  .post-rule {
    margin: 8px 0 4px;
  }
  .updated {
    margin-top: 48px;
    font-size: 13px;
    color: var(--ink-3);
  }
</style>

<style is:global>
  .prose {
    font-size: 18px;
    line-height: 1.8;
  }
  .prose > * {
    max-width: var(--measure);
  }
  .prose h2 {
    font-size: 26px;
    margin: 48px 0 14px;
  }
  .prose h3 {
    font-size: 20px;
    margin: 36px 0 10px;
  }
  .prose p,
  .prose ul,
  .prose ol {
    margin: 16px 0;
  }
  .prose blockquote {
    margin: 24px 0;
    padding: 8px 18px;
    border-left: 3px solid var(--signature);
    background: var(--surface);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--ink-2);
  }
  .prose img {
    margin: 24px 0;
  }
</style>
