---
import BaseLayout from "./BaseLayout.astro";
import { POSTS_URL } from "../lib/urls";
import AuthorProfile from "../components/AuthorProfile.astro";
import PostNav from "../components/PostNav.astro";
import SeriesEpisodes from "../components/SeriesEpisodes.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import { formatDate, readingTime } from "../lib/format";
import { getRelatedPosts } from "../lib/related";
import { getSeriesPosts, episodeNumber } from "../lib/seriesNav";
import { getAuthor } from "../lib/authors";
import { TALK, publicFileExists } from "../lib/talk";
import { getCollection, type CollectionEntry } from "astro:content";

/**
 * 폭신 대담 — 인터뷰 시리즈 포스트 레이아웃 (디자인 1a/1c → 1d/1e 골격)
 * frontmatter에 template: "talk"를 지정하면 적용된다.
 * 본문은 <QA>·<PullQuote> 컴포넌트(src/components/talk/)로 구성한다.
 */
interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
const { title, description, pubDate, series, tags } = post.data;
const author = getAuthor(post.data.author);
const minutes = readingTime(post.body);
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const related = getRelatedPosts(post, allPosts);

const seriesPosts = getSeriesPosts(post, allPosts);
const ep = series ? String(episodeNumber(post, seriesPosts)).padStart(2, "0") : null;

const bannerOk = publicFileExists(TALK.banner);
const profOk = publicFileExists(TALK.interviewee.avatar);
const slug = post.id.replace(/\.(md|mdx)$/, "");
const ogImage = bannerOk ? TALK.banner : `/images/${slug}/hero.webp`;
---

<BaseLayout title={title} description={description} image={ogImage} type="article">
  <article class="talk">
    {
      bannerOk && (
        <figure class="talk-banner">
          <img src={TALK.banner} alt={TALK.bannerAlt} loading="eager" decoding="async" />
        </figure>
      )
    }

    <header class="talk-header">
      <div class="talk-kicker">
        {series && <span class="kicker-series">{series}</span>}
        {series && ep && <span class="kicker-dot" aria-hidden="true" />}
        {ep && <span class="kicker-ep">EP.{ep}</span>}
      </div>
      <div class="talk-hand">{TALK.handLead}</div>
      <h1 transition:name={`post-${slug}-title`}>{title}</h1>
      {description && <p class="talk-lead">{description}</p>}
      <div class="talk-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span class="meta-sep">/</span>
        <span>읽는 데 {minutes}분</span>
        {
          tags.length > 0 && (
            <>
              <span class="meta-sep">/</span>
              <span class="meta-tags">{tags.map((t) => `#${t}`).join(" ")}</span>
            </>
          )
        }
      </div>
    </header>

    <div class="speakers">
      <div class="speaker speaker-me">
        <span class="speaker-avatar speaker-initial">{TALK.interviewer.initial}</span>
        <span>
          <span class="speaker-name">{TALK.interviewer.name}</span>
          <span class="speaker-role">{TALK.interviewer.label}</span>
        </span>
      </div>
      <span class="speakers-x" aria-hidden="true">×</span>
      <div class="speaker speaker-ai">
        {
          profOk ? (
            <img class="speaker-avatar" src={TALK.interviewee.avatar} alt={TALK.interviewee.name} />
          ) : (
            <span class="speaker-avatar speaker-initial">빵</span>
          )
        }
        <span>
          <span class="speaker-name">{TALK.interviewee.name}</span>
          <span class="speaker-role">{TALK.interviewee.label}</span>
        </span>
      </div>
    </div>

    <nav class="talk-toc" aria-label="오늘의 질문" hidden>
      <div class="toc-label">오늘의 질문 · CONTENTS</div>
      <ol class="toc-list"></ol>
    </nav>

    <div class="talk-body">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <div class="talk-tags">
          {tags.map((t) => (
            <a href={POSTS_URL} class="tag-pill">#{t}</a>
          ))}
        </div>
      )
    }

    <PostNav post={post} allPosts={allPosts} />
    <SeriesEpisodes post={post} allPosts={allPosts} title={series ? `지난 대담 다시보기` : undefined} />
    <div class="talk-author">
      <AuthorProfile authorId={author.id} />
    </div>
    <RelatedPosts items={related} />
  </article>
</BaseLayout>

<script>
  // 오늘의 질문 목차: 본문의 QA 제목(h3[data-qa])을 수집해 채운다.
  const toc = document.querySelector(".talk-toc");
  const list = toc?.querySelector(".toc-list");
  const questions = document.querySelectorAll<HTMLElement>(".talk-body [data-qa]");
  if (toc && list && questions.length > 0) {
    questions.forEach((h) => {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `#${h.id}`;
      const num = document.createElement("span");
      num.className = "toc-num";
      num.textContent = h.dataset.qa ?? "";
      a.append(num, document.createTextNode(h.textContent ?? ""));
      li.appendChild(a);
      list.appendChild(li);
    });
    toc.removeAttribute("hidden");
  }
</script>

<style>
  .talk {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-32) var(--page-pad) 0;
  }

  /* ── 배너 ── */
  .talk-banner {
    margin: 0 0 var(--space-8);
  }
  .talk-banner img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: var(--stroke) solid var(--border);
  }

  /* ── 헤더 ── */
  .talk-header {
    padding: var(--space-32) 0 var(--space-24);
    text-align: center;
  }
  .talk-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-10);
    margin-bottom: var(--space-16);
  }
  .kicker-series {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    /* 2px 이던 자리다. 11px 에서 0.182em 이라 거리로는 deco 인데, 시리즈명이 한글
       (`폭신함 외길 인생`)이라 한 단 아래다(§5). 바로 아래 .kicker-ep 은 `EP.01` 로
       **라틴 전용이라 안 내렸다** — 값이 아니라 그 요소의 텍스트가 단을 정한다. */
    letter-spacing: var(--font-track-wide);
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .kicker-dot {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-round);
    background: var(--accent);
  }
  .kicker-ep {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--font-track-wide);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: var(--space-2) var(--space-10);
    border-radius: var(--btn-radius);
  }
  .talk-hand {
    font-family: var(--font-hand);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-h3);
    color: var(--accent);
    rotate: -2deg;
    margin-bottom: var(--space-12);
  }
  /* 램프는 6vw 로 두고 끝값만 역할값으로 맞춘다 — `posts/index.astro` 가 같은 수법이다.
     `var(--text-h1)` 을 그대로 쓰면 5vw 라 지면마다 제목이 다른 속도로 자란다.
     상한이 46 → 38px(-17%) 내려가는 것은 유저 판정이다(2026-08-27) — §5 의 H1(38)~
     Display(60) 빈칸에 실재하는 값은 46px 이 자리 하나뿐이라, 칸을 세우면 스케일이 아니라
     지면 하나짜리 별칭이 된다. 게이트는 clamp 끝값을 역할값으로 받으므로 이 표기가 준수다. */
  .talk-header h1 {
    font-family: var(--font-display);
    font-weight: var(--font-weight-regular);
    font-size: clamp(28px, 6vw, 38px);
    line-height: var(--font-leading-title);
    letter-spacing: var(--font-track-tight);
    color: var(--ink);
    margin: 0 0 var(--space-16);
  }
  .talk-lead {
    font-size: var(--text-body);
    line-height: var(--font-leading-talk);
    color: var(--ink-2);
    max-width: 520px;
    margin: 0 auto;
  }
  .talk-meta {
    display: flex;
    gap: var(--space-14);
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    margin-top: var(--space-24);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--ink-3);
  }
  .meta-sep {
    opacity: 0.4;
  }
  .meta-tags {
    color: var(--accent);
  }

  /* ── 화자 ── */
  .speakers {
    display: flex;
    gap: var(--space-14);
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    padding: var(--space-4) 0 var(--space-32);
  }
  .speaker {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    background: var(--cream);
    border-radius: var(--btn-radius);
    padding: var(--space-8) var(--space-16) var(--space-8) var(--space-8);
  }
  .speaker-ai {
    background: var(--accent);
  }
  .speaker-avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-round);
    object-fit: cover;
    object-position: center 18%;
    background: var(--surface);
  }
  .speaker-initial {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--text-body);
    color: var(--ink);
  }
  .speaker-name {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-small);
    color: var(--ink);
  }
  .speaker-ai .speaker-name {
    color: var(--paper);
  }
  .speaker-role {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-nano);
    color: var(--ink-3);
  }
  .speaker-ai .speaker-role {
    color: var(--accent-tint);
  }
  .speakers-x {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    color: var(--accent);
  }

  /* ── 목차 ── */
  .talk-toc {
    background: var(--cream);
    border-radius: var(--card-radius);
    padding: var(--space-24) var(--space-32);
    margin-bottom: var(--space-16);
  }
  .toc-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    /* 1.5px 이던 자리다. 11px 에서 0.136em 이라 거리로는 wide 인데, 문구가
       `오늘의 질문 · CONTENTS` 라 한글이 들어 한 단 아래다(§5). */
    letter-spacing: var(--font-track-label);
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: var(--space-16);
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12) var(--space-32);
  }
  .toc-list :global(a) {
    display: flex;
    gap: var(--space-12);
    font-size: var(--text-small);
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .toc-list :global(a:hover) {
    color: var(--accent);
  }
  .toc-list :global(.toc-num) {
    font-family: var(--font-mono);
    color: var(--accent);
  }
  @media (max-width: 560px) {
    .toc-list {
      grid-template-columns: 1fr;
    }
  }

  /* ── 태그 ── */
  .talk-tags {
    display: flex;
    gap: var(--space-8);
    flex-wrap: wrap;
    margin-top: var(--space-24);
  }
  .tag-pill {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--accent);
    border: var(--stroke-hair) solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: var(--btn-radius);
    padding: var(--space-4) var(--space-14);
    text-decoration: none;
    transition: background var(--dur) var(--ease);
  }
  .tag-pill:hover {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .talk-author {
    margin-top: var(--space-48);
  }
</style>

<style is:global>
  /* 마치며 — 본문 마지막 h2("마치며") 섹션은 액센트 보더 스타일 */
  .talk-body {
    font-size: var(--text-body);
    line-height: var(--font-leading-talk);
  }
  .talk-body > p {
    color: var(--ink-2);
    margin: var(--space-16) 0;
  }
  .talk-body h2 {
    font-family: var(--font-display);
    font-weight: var(--font-weight-regular);
    font-size: var(--text-h3);
    color: var(--ink);
    border-left: var(--stroke-bold) solid var(--accent);
    padding-left: var(--space-16);
    margin: var(--space-48) 0 var(--space-14);
  }
</style>
