---
import BaseLayout from "./BaseLayout.astro";
import AuthorProfile from "../components/AuthorProfile.astro";
import PostNav from "../components/PostNav.astro";
import SeriesEpisodes from "../components/SeriesEpisodes.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import { formatDate, readingTime } from "../lib/format";
import { getRelatedPosts } from "../lib/related";
import { getSeriesPosts, episodeNumber } from "../lib/seriesNav";
import { getAuthor } from "../lib/authors";
import { TALK, publicFileExists } from "../lib/talk";
import { getCollection, type CollectionEntry } from "astro:content";

/**
 * 폭신 대담 — 인터뷰 시리즈 포스트 레이아웃 (디자인 1a/1c → 1d/1e 골격)
 * frontmatter에 template: "talk"를 지정하면 적용된다.
 * 본문은 <QA>·<PullQuote> 컴포넌트(src/components/talk/)로 구성한다.
 */
interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
const { title, description, pubDate, series, tags } = post.data;
const author = getAuthor(post.data.author);
const minutes = readingTime(post.body);
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const related = getRelatedPosts(post, allPosts);

const seriesPosts = getSeriesPosts(post, allPosts);
const ep = series ? String(episodeNumber(post, seriesPosts)).padStart(2, "0") : null;

const bannerOk = publicFileExists(TALK.banner);
const profOk = publicFileExists(TALK.interviewee.avatar);
const slug = post.id.replace(/\.(md|mdx)$/, "");
const ogImage = bannerOk ? TALK.banner : `/images/${slug}/hero.webp`;
---

<BaseLayout title={title} description={description} image={ogImage} type="article">
  <article class="talk">
    {
      bannerOk && (
        <figure class="talk-banner">
          <img src={TALK.banner} alt={TALK.bannerAlt} loading="eager" decoding="async" />
        </figure>
      )
    }

    <header class="talk-header">
      <div class="talk-kicker">
        {series && <span class="kicker-series">{series}</span>}
        {series && ep && <span class="kicker-dot" aria-hidden="true" />}
        {ep && <span class="kicker-ep">EP.{ep}</span>}
      </div>
      <div class="talk-hand">{TALK.handLead}</div>
      <h1>{title}</h1>
      {description && <p class="talk-lead">{description}</p>}
      <div class="talk-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span class="meta-sep">/</span>
        <span>읽는 데 {minutes}분</span>
        {
          tags.length > 0 && (
            <>
              <span class="meta-sep">/</span>
              <span class="meta-tags">{tags.map((t) => `#${t}`).join(" ")}</span>
            </>
          )
        }
      </div>
    </header>

    <div class="speakers">
      <div class="speaker speaker-me">
        <span class="speaker-avatar speaker-initial">{TALK.interviewer.initial}</span>
        <span>
          <span class="speaker-name">{TALK.interviewer.name}</span>
          <span class="speaker-role">{TALK.interviewer.label}</span>
        </span>
      </div>
      <span class="speakers-x" aria-hidden="true">×</span>
      <div class="speaker speaker-ai">
        {
          profOk ? (
            <img class="speaker-avatar" src={TALK.interviewee.avatar} alt={TALK.interviewee.name} />
          ) : (
            <span class="speaker-avatar speaker-initial">빵</span>
          )
        }
        <span>
          <span class="speaker-name">{TALK.interviewee.name}</span>
          <span class="speaker-role">{TALK.interviewee.label}</span>
        </span>
      </div>
    </div>

    <nav class="talk-toc" aria-label="오늘의 질문" hidden>
      <div class="toc-label">오늘의 질문 · CONTENTS</div>
      <ol class="toc-list"></ol>
    </nav>

    <div class="talk-body">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <div class="talk-tags">
          {tags.map((t) => (
            <a href={`/posts`} class="tag-pill">#{t}</a>
          ))}
        </div>
      )
    }

    <PostNav post={post} allPosts={allPosts} />
    <SeriesEpisodes post={post} allPosts={allPosts} title={series ? `지난 대담 다시보기` : undefined} />
    <div class="talk-author">
      <AuthorProfile authorId={author.id} />
    </div>
    <RelatedPosts items={related} />
  </article>
</BaseLayout>

<script>
  // 오늘의 질문 목차: 본문의 QA 제목(h3[data-qa])을 수집해 채운다.
  const toc = document.querySelector(".talk-toc");
  const list = toc?.querySelector(".toc-list");
  const questions = document.querySelectorAll<HTMLElement>(".talk-body [data-qa]");
  if (toc && list && questions.length > 0) {
    questions.forEach((h) => {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `#${h.id}`;
      const num = document.createElement("span");
      num.className = "toc-num";
      num.textContent = h.dataset.qa ?? "";
      a.append(num, document.createTextNode(h.textContent ?? ""));
      li.appendChild(a);
      list.appendChild(li);
    });
    toc.removeAttribute("hidden");
  }
</script>

<style>
  .talk {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 40px var(--page-pad) 0;
  }

  /* ── 배너 ── */
  .talk-banner {
    margin: 0 0 8px;
  }
  .talk-banner img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: var(--stroke) solid var(--border);
  }

  /* ── 헤더 ── */
  .talk-header {
    padding: 36px 0 24px;
    text-align: center;
  }
  .talk-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }
  .kicker-series {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .kicker-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .kicker-ep {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 3px 10px;
    border-radius: 20px;
  }
  .talk-hand {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 22px;
    color: var(--accent);
    rotate: -2deg;
    margin-bottom: 12px;
  }
  .talk-header h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 6vw, 46px);
    line-height: 1.22;
    letter-spacing: -1px;
    color: var(--ink);
    margin: 0 0 18px;
  }
  .talk-lead {
    font-size: 17px;
    line-height: 1.9;
    color: var(--ink-2);
    max-width: 520px;
    margin: 0 auto;
  }
  .talk-meta {
    display: flex;
    gap: 14px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
  }
  .meta-sep {
    opacity: 0.4;
  }
  .meta-tags {
    color: var(--accent);
  }

  /* ── 화자 ── */
  .speakers {
    display: flex;
    gap: 14px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    padding: 4px 0 32px;
  }
  .speaker {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--cream);
    border-radius: 40px;
    padding: 8px 20px 8px 8px;
  }
  .speaker-ai {
    background: var(--accent);
  }
  .speaker-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 18%;
    background: var(--surface);
  }
  .speaker-initial {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--ink);
  }
  .speaker-name {
    display: block;
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--ink);
  }
  .speaker-ai .speaker-name {
    color: var(--paper);
  }
  .speaker-role {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-3);
  }
  .speaker-ai .speaker-role {
    color: var(--accent-tint);
  }
  .speakers-x {
    font-family: var(--font-mono);
    font-size: 18px;
    color: var(--accent);
  }

  /* ── 목차 ── */
  .talk-toc {
    background: var(--cream);
    border-radius: 14px;
    padding: 24px 30px;
    margin-bottom: 20px;
  }
  .toc-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 16px;
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 40px;
  }
  .toc-list :global(a) {
    display: flex;
    gap: 12px;
    font-size: 15px;
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .toc-list :global(a:hover) {
    color: var(--accent);
  }
  .toc-list :global(.toc-num) {
    font-family: var(--font-mono);
    color: var(--accent);
  }
  @media (max-width: 560px) {
    .toc-list {
      grid-template-columns: 1fr;
    }
  }

  /* ── 태그 ── */
  .talk-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .tag-pill {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 20px;
    padding: 5px 14px;
    text-decoration: none;
    transition: background var(--dur) var(--ease);
  }
  .tag-pill:hover {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .talk-author {
    margin-top: 56px;
  }
</style>

<style is:global>
  /* 마치며 — 본문 마지막 h2("마치며") 섹션은 액센트 보더 스타일 */
  .talk-body {
    font-size: 17px;
    line-height: 1.9;
  }
  .talk-body > p {
    color: var(--ink-2);
    margin: 16px 0;
  }
  .talk-body h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 22px;
    color: var(--ink);
    border-left: 3px solid var(--accent);
    padding-left: 16px;
    margin: 44px 0 14px;
  }
</style>
