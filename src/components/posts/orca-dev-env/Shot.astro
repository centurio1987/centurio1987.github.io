---
/**
 * 이 글의 화면 캡처 한 장 = 액자(PF1 폴라로이드 + 마테) 하나.
 *
 * 액자를 손으로 고르지 않고 `photoFrames.ts` 의 선택 로직에 물었다 —
 * `{ content:"photo", surface:"body", orient:"wide" }` 를 통과하는 것 중
 * **캡션 자리를 가진 가장 조용한 액자**가 PF1 이다(PF3 이 더 조용하지만
 * `caption:false` 라 이 글의 아홉 장에 이름을 못 붙인다. 캡처는 "무엇을 찍은
 * 것인가"가 없으면 앞뒤 문단을 다시 읽어야 뜻이 선다).
 *
 * ── 굳힌 판단 셋 ────────────────────────────────────────────────────────────
 *
 * ① **`ratio` 를 반드시 넘긴다.** `.well` 은 `object-fit: cover` 라 칸 비율이
 *    그림과 다르면 **말없이 잘린다** — 사진이면 가장자리가 좀 잘려도 되지만
 *    화면 캡처는 잘린 자리가 곧 UI 라 그림이 거짓말이 된다(`photoFrames.ts` 가
 *    도식을 열두 액자에서 전부 떨어뜨린 것과 같은 사유). 그림의 실제
 *    세로/가로를 그대로 넘기면 cover 는 아무것도 안 자른다.
 *
 * ② **폭은 뷰포트가 아니라 글 폭에서 받는다.** `--w` 는 `.well` 의 `width` 로 바로
 *    들어가는데 액자 뿌리(`.pf`)가 `inline-block`(= shrink-to-fit)이라 `%` 를 그냥
 *    넘기면 폭이 자기 자신을 참조한다. 그래서 `.pf` 를 **먼저 블록으로 펴** 놓고
 *    (아래 `:global(.pf)`) `%` 를 넘긴다 — 그러면 `.well` 이 판 안쪽 폭을 그대로 받아
 *    글 폭에 정확히 맞는다.
 *    **한때는 vw 로 계산했다**(`min(540px, calc(100vw - 110px))`). 그 110px 안에는
 *    판 좌우 여백 22px 말고 **기울기가 밖으로 내미는 몫**이 섞여 있었고, `100vw` 는
 *    스크롤바를 포함해서 데스크톱 600px 대 창에서 되레 넘칠 여지가 있었다. 액자가
 *    반듯해진 지금은 각도 몫이 사라졌으므로 어림값을 쓸 이유도 함께 없어졌다.
 *
 * ③ **칸 안의 `img` 마진을 0 으로 죽인다.** `PostLayout` 의 전역 규칙
 *    `.prose img { margin: 24px auto }` 가 액자 안까지 따라 들어와 그림을
 *    칸에서 밀어낸다(칸은 `overflow:hidden` 이라 밀린 만큼 조용히 잘린다).
 */
import PhotoFrame from "../../deco/patterns/PhotoFrame.astro";

interface Props {
  /** `/images/orca-dev-env/<name>.webp` */
  src: string;
  /** 그림이 무엇을 담고 있는지 — 액자 캡션과 겹치지 않게 구체적으로 */
  alt: string;
  /** 액자 아래 손글씨 한 줄 */
  caption: string;
  /** 그림의 실제 세로/가로. 위 ① — 어림하지 말고 파일에서 잰 값을 넣는다 */
  ratio: number;
}
const { src, alt, caption, ratio } = Astro.props;
---

<figure class="shot">
  <PhotoFrame variant="polaroid-tape" width="100%" ratio={ratio} caption={caption}>
    <img src={src} alt={alt} loading="lazy" decoding="async" />
  </PhotoFrame>
</figure>

<style>
  .shot {
    display: flex;
    justify-content: center;
    /* 문단 간격(16px)의 두 배. 액자는 문단이 아니라 **끼워 넣은 물건**이라
       앞뒤 글과 같은 간격이면 문단 하나로 딸려 읽힌다. */
    margin: var(--space-32) 0;
  }
  /* 위 ② — 부모 scoped CSS 로는 자식 컴포넌트 루트를 못 고치므로(자식엔 자식의
     `data-astro-cid` 만 붙는다) 내 요소인 `.shot` 아래에서 `:global()` 로 연다.
     `inline-block` 을 펴야 `width:100%` 가 자기 자신이 아니라 글 폭을 참조한다.
     상한 562px = 사진 칸 540px + 판 좌우 여백 11px 씩. */
  .shot :global(.pf) {
    display: block;
    width: 100%;
    max-width: 562px;
  }
  /* 위 ③ — 전역 `.prose img` 의 마진을 액자 안에서만 되돌린다 */
  .shot img {
    margin: 0;
  }
</style>
