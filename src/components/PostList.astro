---
import type { CollectionEntry } from "astro:content";
import { getCategory } from "../lib/categories";
import { getAuthor } from "../lib/authors";
import { formatYear, readingTime } from "../lib/format";
import { postUrl } from "../lib/urls";

interface Props {
  posts: CollectionEntry<"posts">[];
}
const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post, i) => {
      const cat = getCategory(post.data.category);
      const author = getAuthor(post.data.author);
      const minutes = readingTime(post.body);
      // shared-element 제목: 목록 → 글 상세로 전환할 때 제목이 이어지도록 canonical
      // 이름을 부여한다. PostList 는 주 목록(/posts·/categories/*)에서만 쓰여 한
      // 페이지에 같은 글이 한 번만 나오므로 name 유일성이 보장된다(RelatedPosts 등
      // 부차 목록엔 부여하지 않는다). 값은 PostLayout <h1> 과 동일 규칙.
      const titleTransition = `post-${post.id.replace(/\.(md|mdx)$/, "")}-title`;
      return (
        <li
          class="post-item"
          data-reveal="up"
          style={`--reveal-i:${i}`}
          data-cat={post.data.category}
          data-author={author.id}
        >
          <a href={postUrl(post.id)} class="post-link">
            <span class="bullet" style={`--cat:${cat.color}`} aria-hidden="true" />
            <span class="post-body">
              <span class="post-meta">
                <span class="post-cat" style={`--cat:${cat.color}`}>
                  {cat.label}
                </span>
                <span class="dot">·</span>
                <span class="post-author">
                  {/* 저자 프로필 사진. 바로 옆에 이름이 텍스트로 있으므로 alt 는 비워
                      스크린리더 중복 낭독을 막는다(순수 장식). */}
                  {author.avatarSm || author.avatar ? (
                    <img
                      class="author-avatar"
                      src={author.avatarSm ?? author.avatar}
                      alt=""
                      width="22"
                      height="22"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="author-avatar author-avatar--hatch" aria-hidden="true">
                      {author.name.slice(0, 1)}
                    </span>
                  )}
                  {author.name}
                  {author.isAI && <span class="ai-chip">AI</span>}
                </span>
                <span class="dot">·</span>
                <span>{formatYear(post.data.pubDate)}</span>
                <span class="dot">·</span>
                <span>{minutes}분</span>
              </span>
              <span class="post-title" transition:name={titleTransition}>
                {post.data.title}
              </span>
              {post.data.description && (
                <span class="post-desc">{post.data.description}</span>
              )}
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-item + .post-item {
    border-top: 1px dashed var(--border);
  }
  .post-link {
    display: flex;
    gap: 14px;
    padding: 18px 0;
    color: var(--ink);
  }
  .bullet {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-top: 7px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--cat) 45%, var(--surface));
    border: 1.5px solid var(--ink);
    transition: background var(--dur) var(--ease);
  }
  .post-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-3);
  }
  .post-cat {
    color: color-mix(in srgb, var(--cat) 78%, var(--ink));
  }
  .dot {
    color: var(--ink-3);
  }
  .post-author {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .author-avatar {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--paper);
    box-shadow: 0 0 0 1.5px var(--accent);
  }
  .author-avatar--hatch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 11px;
    color: var(--accent);
    background: var(--hatch);
  }
  .ai-chip {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.5px;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--btn-radius);
    padding: 2px 6px;
  }
  .post-title {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: color var(--dur) var(--ease);
  }
  .post-desc {
    font-size: 15px;
    color: var(--ink-2);
  }
  .post-link:hover .bullet {
    background: var(--cat);
  }
  .post-link:hover .post-title {
    color: var(--accent);
  }
</style>
