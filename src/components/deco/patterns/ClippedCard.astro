---
/**
 * 패턴 P-03 — 클립으로 물린 카드.
 *
 * 시안 1b 의 필터 카드와 1d 의 시리즈 카드가 같은 짜임이다: 반투명 카드 위 모서리에
 * 클립(또는 집게)이 물려 있다. 카드가 페이지에 인쇄된 게 아니라 **끼워 넣은 종이**로
 * 읽히게 하는 장치다.
 *
 * 클립은 카드 위쪽 밖으로 절반쯤 나와야 물린 것으로 보인다(top 음수). 왼쪽·오른쪽
 * 어디에 물릴지는 카드 안 내용이 비어 있는 쪽을 골라 side 로 넘긴다.
 */
import DecoLayer from "../DecoLayer.astro";
import Clip from "../Clip.astro";

interface Props {
  variant?: "clip" | "binder";
  side?: "left" | "right";
  /**
   * 모서리에서 안쪽으로 얼마나 들어와 물릴지.
   *
   * **음수도 정식 값이다** — 그때는 모서리 밖으로 내밀어 *걸친다*. 카드 첫 행의 양
   * 끝이 다 차 있어(라벨·버튼) 안쪽 어디에도 못 무는 판에서 쓴다(글 지도 후보 패널이
   * 그렇다: 회전한 클립 상자가 35.4px 라 **어떤 양수 값도** 오른쪽 끝 `전체` 버튼을
   * 문다). 대신 밖으로 나간 몫이 **가로 오버플로**로 바뀌므로 좁은 화면에서 접을
   * 문턱을 함께 정해야 한다 — 판정은 `bun run deco:verify` 가 한다.
   */
  offset?: string;
  rotate?: number;
  tier?: 1 | 2 | 3 | 4;
  /**
   * 클립의 호버 갸웃. 기본 켬.
   *
   * 끄는 이유는 모션이 싫어서가 아니라 **입력** 때문이다 — `DecoLayer` 는 갸웃을
   * 받으려고 자식의 `pointer-events` 를 되살리는데(§5 규칙 9), 그 되살림은 조상의
   * `pointer-events:none` 을 이긴다. 클립은 카드 **밖 위쪽**으로 나오므로 그 위에
   * 무엇이 있느냐가 문제가 된다: 글 지도의 후보 패널은 바로 위가 커맨드 바(=텍스트
   * 입력)라, 안 끄면 클립이 그 자리의 클릭을 먹어 입력이 죽는다.
   *
   * `TapedBoard` 의 같은 이름 prop 과 같은 이유·같은 꼴이다.
   */
  hover?: boolean;
  class?: string;
}
const {
  variant = "clip",
  side = "right",
  offset = "26px",
  rotate = side === "right" ? 14 : -16,
  tier = 2,
  hover = true,
  class: className = "",
} = Astro.props;
---

<div class:list={["clipped-card", className]}>
  <slot />
  <DecoLayer
    top={variant === "binder" ? "-20px" : "-19px"}
    left={side === "left" ? offset : undefined}
    right={side === "right" ? offset : undefined}
    rotate={rotate}
    tier={tier}
    z={2}
    hover={hover}
  >
    <Clip variant={variant} />
  </DecoLayer>
</div>

<style>
  .clipped-card {
    position: relative;
  }
</style>
