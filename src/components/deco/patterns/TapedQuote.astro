---
/**
 * 패턴 P-04 — 테이프로 붙인 인용.
 *
 * 시안 1d 의 인용 블록. 왼쪽 세로선 + 그 위 모서리에 벨럼 테이프 한 장, 아래에
 * 손글씨 출처가 붙는다.
 *
 * 인용 위에 붙는 테이프는 **반투명(T3 vellum)이 기본**이다. 인용문은 읽으라고 있는
 * 글이라 불투명 테이프를 얹으면 첫 줄이 가려진다 — 테이프는 세로선 위쪽, 글자가
 * 시작되기 전 자리에만 걸친다.
 */
import DecoLayer from "../DecoLayer.astro";
import Tape from "../Tape.astro";

interface Props {
  /** 손글씨 출처 (— 여섯 편을 다 굽고 나서) */
  cite?: string;
  tape?: "vellum" | "check" | "stripe" | "dot";
  class?: string;
}
const {
  cite = "",
  tape = "vellum",
  class: className = "",
} = Astro.props;
---

<figure class:list={["taped-quote", className]}>
  <DecoLayer top="-16px" left="14px" rotate={-6} tier={2} z={2}>
    <Tape variant={tape} width={96} />
  </DecoLayer>
  <blockquote>
    <slot />
  </blockquote>
  {cite && <figcaption>{cite}</figcaption>}
</figure>

<style>
  .taped-quote {
    position: relative;
    margin: 34px 0;
    padding: 6px 0 6px 22px;
    border-left: 3px solid var(--deco-pink);
  }
  /* 패턴이 자체 테두리·여백을 쥐므로 .prose blockquote 의 기본 장식은 지운다 */
  .taped-quote blockquote {
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    border-radius: 0;
    font-size: 19px;
    font-weight: 500;
    line-height: 1.8;
    color: var(--ink);
  }
  .taped-quote figcaption {
    margin-top: 8px;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 19px;
    color: var(--ink-3);
  }
</style>
