---
/**
 * 패턴 P-05 — 테이프 붙인 코드블록.
 *
 * 시안 1d 의 코드블록. 어두운 블록 위 모서리에 레터링 테이프("CHECK THIS")와 사선
 * 테이프가 붙고, 오른쪽 아래로 포스트잇이 삐져나온다.
 *
 * 여기가 데코를 얹을 수 있는 **한계 지점**이다 — 코드는 한 글자만 가려도 못 쓰게 되므로:
 *   ① 테이프는 블록 **위쪽 밖**(top 음수)에만 붙인다. 블록 안으로 내려오면 안 된다.
 *   ② 포스트잇은 오른쪽 **바깥**으로 밀어낸다(right 음수).
 *   ③ 둘 다 티어 3 — 강도를 낮추면 코드만 남는다.
 * 코드 위를 덮는 데코는 금지다. 강조가 필요하면 코드 안의 하이라이트를 쓴다.
 */
import DecoLayer from "../DecoLayer.astro";
import Tape from "../Tape.astro";
import StickyNote from "../StickyNote.astro";

interface Props {
  /** 레터링 테이프 문구. 비우면 테이프를 안 붙인다. */
  label?: string;
  /** 포스트잇 문구. 비우면 포스트잇을 안 붙인다. 줄바꿈은 \n. */
  note?: string;
  class?: string;
}
const { label = "", note = "", class: className = "" } = Astro.props;
---

<div class:list={["taped-code", { "has-note": note }, className]}>
  <slot />

  {
    label && (
      <DecoLayer top="-13px" left="36px" rotate={-5} tier={3} z={2}>
        {/* 코드블록은 어두운 판이라 on-dark — 기본값은 여기서 통째로 묻힌다 */}
        <Tape variant="letter" width={110} label={label} tone="dark" />
      </DecoLayer>
    )
  }

  <DecoLayer top="-12px" right="30px" rotate={6} tier={3} z={2}>
    <Tape variant="stripe" width={92} />
  </DecoLayer>

  {
    note && (
      <DecoLayer bottom="-26px" right="-30px" rotate={-5} tier={3} z={2}>
        <StickyNote text={note} width={112} />
      </DecoLayer>
    )
  }
</div>

<style>
  .taped-code {
    position: relative;
    /* 테이프가 위로 13px 삐져나오므로 위 여백을 그만큼 확보한다 */
    margin: 30px 0;
  }
  /* 포스트잇이 오른쪽 밖으로 나가는 만큼 아래 여백도 준다 */
  .taped-code.has-note {
    margin-bottom: 44px;
  }
  /* 안에 들어온 코드블록은 데코가 얹힐 대비로 살짝 띄운다 */
  .taped-code :global(pre) {
    margin: 0;
    box-shadow: 0 3px 10px rgba(32, 38, 74, 0.14);
  }

  /* 좁은 화면에서는 포스트잇이 화면 밖으로 나간다 — 데코를 접는다.
     코드 가독성이 장식보다 먼저다. */
  @media (max-width: 768px) {
    .taped-code :global(.deco-layer) {
      display: none;
    }
    .taped-code.has-note {
      margin-bottom: 30px;
    }
  }
</style>
