<style>
  /* ── D1 반짝 (4각) ──
     SVG path 가 아니라 시안대로 clip-path 를 쓴다. 필터를 SVG 안에 두면
     feDisplacementMap 의 scale 이 **viewBox 단위**로 해석돼, 100 단위를 30px 에
     그리는 별에서는 결이 3배 이상 잘게 갈린다(매끈한 별이 된다). HTML 요소에
     CSS filter 로 걸면 scale 이 곧 CSS px 여서 시안과 같은 굵기로 떨린다. */
  .sparkles {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .sp {
    display: block;
    clip-path: polygon(
      50% 0,
      57% 43%,
      100% 50%,
      57% 57%,
      50% 100%,
      43% 57%,
      0 50%,
      43% 43%
    );
  }

  /* ── D2 하트 ── */
  .hearts {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    line-height: 1;
  }
  .ht {
    line-height: 1;
  }

  .arrow,
  .wave {
    display: block;
    overflow: visible;
  }

  /* ── D5 강조선 · 별표 ── */
  .emphasis {
    display: inline-flex;
    align-items: center;
    gap: 22px;
  }
  .speed,
  .asterisk {
    display: block;
    overflow: visible;
  }

  /* ── D7·D8·D9 낙서 두들 ────────────────────────────────────────────────
   * D1~D6 이 "가는 펜으로 그은 것"이라면 이 셋은 "크레용으로 칠하고 굵게 두른 것"이다.
   * 세 겹으로 만든다 — 칠을 2~3px 어긋나게 두고(선 밖으로 삐져나온 색) 그 위에 짙은
   * 결·옅은 결을 엇갈려 긋고, 마지막에 같은 길을 굵은 잉크로 두른다. 칠만 하면
   * 스티커로 읽히고, 선만 두르면 아이콘이 된다.
   *
   * 색은 시안 hex 그대로다(--deco-crayon-*). 코어 팔레트로 환산했다가 되돌린
   * 이유는 deco.css 머리글에 있다.
   */
  .scribble {
    display: block;
    overflow: visible;
  }
  .scribble-heart {
    --fill: var(--deco-crayon-pink);
    --deep: var(--deco-crayon-pink-deep);
    --pale: var(--deco-crayon-pink-pale);
  }
  .bolt {
    --fill: var(--deco-crayon-yellow);
    --deep: var(--deco-crayon-yellow-deep);
    --pale: var(--deco-crayon-yellow-pale);
  }
  .barley {
    --deep: var(--deco-crayon-wheat);
    --pale: var(--deco-crayon-wheat-pale);
  }

  /* ── D10·D11·D12 풍선 두들 ─────────────────────────────────────────────
   * 낙서 셋과 같은 필기구인데(크레용 칠 + 굵은 잉크) **안에 글씨가 들어간다.**
   * 글씨를 SVG <text> 로 넣지 않고 HTML 로 얹는 이유는 시안이 그렇게 그렸기
   * 때문이기도 하지만, 실질적으로는 줄바꿈이다 — <text> 는 줄바꿈이 없어 <tspan>
   * 마다 dy 를 손으로 적어야 하고, 그러면 D6 메모처럼 \n 으로 쓸 수가 없다.
   *
   * 글씨엔 필터를 걸지 않는다(시안도 .rgh 를 안 붙였다). Gaegu 는 이미 손글씨라
   * 노이즈를 더하면 읽기가 나빠지기만 한다.
   */
  .balloon {
    position: relative;
    display: block;
  }
  .balloon svg {
    display: block;
    overflow: visible;
  }
  .balloon-text {
    position: absolute;
    font-family: var(--font-hand);
    font-weight: 700;
    color: var(--ink);
    text-align: center;
  }
  .speech-balloon {
    --fill: var(--deco-crayon-mint);
    --deep: var(--deco-crayon-mint-deep);
    --pale: var(--deco-crayon-mint-pale);
  }
  .burst-balloon {
    --fill: var(--deco-crayon-pink);
    --deep: var(--deco-crayon-pink-deep);
    /* 하트(D7)보다 한 단 밝은 옅은 결 — 이유는 deco.css */
    --pale: var(--deco-crayon-pink-pale-2);
  }
  .thought-balloon {
    --fill: var(--deco-crayon-peri);
    --deep: var(--deco-crayon-peri-deep);
  }

  /* ── D6 손글씨 메모 ── */
  .memo {
    display: inline-block;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 23px;
    line-height: 1.25;
    color: var(--c, var(--ink-2));
    text-align: center;
  }
</style>
