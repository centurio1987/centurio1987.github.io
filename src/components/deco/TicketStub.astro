---
/**
 * P2 — 티켓 스텁.
 *
 * 양옆이 파여 뜯어낸 표처럼 보이는 라벨. 왼쪽에 짧은 코드(EP 07), 점선 하나 건너
 * 오른쪽에 부연(29분 읽기)이 오는 두 칸 구조다.
 *
 * 시리즈 회차·읽기 시간처럼 **짝을 이루는 두 값**에만 쓴다. 값이 하나면 택 라벨(S5)이
 * 맞다 — 빈 칸이 남으면 티켓으로 안 읽힌다.
 */
interface Props {
  /** 왼쪽 칸 */
  code?: string;
  /** 오른쪽 칸 */
  note?: string;
  width?: number;
  /** 파인 반원이 놓일 바탕색. 부모 배경과 같아야 "구멍"으로 보인다. */
  notch?: string;
  /** true 면 순수 장식으로 보고 스크린리더에서 감춘다. */
  decorative?: boolean;
  class?: string;
}
const {
  code = "",
  note = "",
  width = 158,
  notch = "var(--paper)",
  decorative = true,
  class: className = "",
} = Astro.props;
---

<span
  class:list={["stub", className]}
  style={`--w:${width}px;--notch:${notch}`}
  aria-hidden={decorative ? "true" : undefined}
>
  <span class="hole l" aria-hidden="true"></span>
  <span class="hole r" aria-hidden="true"></span>
  <span class="code">{code}</span>
  <span class="rule" aria-hidden="true"></span>
  <span class="note">{note}</span>
</span>

<style>
  .stub {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: var(--w);
    height: 46px;
    padding-left: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 2px 4px rgba(32, 38, 74, 0.1);
  }
  /* 양옆 반원 — 바탕색 원을 테두리 위에 겹쳐 파낸 것처럼 보이게 한다 */
  .hole {
    position: absolute;
    top: 50%;
    width: 14px;
    height: 14px;
    margin-top: -7px;
    border-radius: 50%;
    background: var(--notch);
    border: 1px solid var(--border);
  }
  .hole.l {
    left: -7px;
  }
  .hole.r {
    right: -7px;
  }
  .code {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--ink);
    white-space: nowrap;
  }
  .rule {
    width: 1px;
    height: 26px;
    margin: 0 12px;
    border-left: 1px dashed color-mix(in srgb, var(--ink) 30%, transparent);
  }
  .note {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--ink-2);
    white-space: nowrap;
  }
</style>
