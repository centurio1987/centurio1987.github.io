---
/**
 * F1 — 폴라로이드 프레임.
 *
 * 아래쪽에 여백을 크게 둔 흰 액자 + 손글씨 캡션. 안에 넣을 것은 slot 으로 받는다
 * (이미지든 마스코트든 아무거나). 사진이 없으면 모눈 종이 바탕이 깔린다 — 시안의
 * "빈 폴라로이드"가 그 상태다.
 */
interface Props {
  caption?: string;
  /**
   * 사진 칸의 폭. 높이는 4:3 비율로 따라간다. 수는 px, 문자열은 CSS 길이 그대로
   * 쓴다(`clamp(...)`) — 액자를 여럿 나란히 세우는 자리에선 좁은 화면에서 액자가
   * 서로 겹치므로 폭이 유동이어야 한다(푸터 저자 라인업).
   */
  width?: number | string;
  /** 사진 칸 바탕 무늬 */
  paper?: "grid" | "dot" | "plain";
  class?: string;
}
const {
  caption = "",
  width = 150,
  paper = "grid",
  class: className = "",
} = Astro.props;
---

<span
  class:list={["polaroid", className]}
  style={`--w:${typeof width === "number" ? `${width}px` : width}`}
  aria-hidden="true"
>
  <span class:list={["shot", paper]}><slot /></span>
  {caption && <span class="caption">{caption}</span>}
</span>

<style>
  .polaroid {
    display: inline-block;
    padding: var(--space-6) var(--space-6) var(--space-24);
    background: var(--surface-hi);
    box-shadow: 0 3px 9px rgba(32, 38, 74, 0.18);
  }
  .shot {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: var(--w);
    height: calc(var(--w) * 0.75);
    overflow: hidden;
    background-color: var(--cream);
  }
  .shot.grid {
    background-image: repeating-linear-gradient(
        0deg,
        color-mix(in srgb, var(--ink) 7%, transparent) 0 1px,
        transparent 1px 11px
      ),
      repeating-linear-gradient(
        90deg,
        color-mix(in srgb, var(--ink) 7%, transparent) 0 1px,
        transparent 1px 11px
      );
  }
  .shot.dot {
    background-image: radial-gradient(
      color-mix(in srgb, var(--ink) 13%, transparent) 1.4px,
      transparent 1.5px
    );
    background-size: 12px 12px;
  }
  /* 안에 들어온 이미지는 액자 폭에 맞추고 라운드를 지운다(global.css 가 img 에
     radius 를 주는데, 액자 안 사진은 각져야 폴라로이드로 읽힌다) */
  .shot :global(img) {
    max-width: 100%;
    /* 액자 밖으로 넘치면 위로 삐져나온다 — 세로도 함께 묶는다 */
    max-height: 100%;
    width: auto;
    height: auto;
    border-radius: 0;
    object-fit: contain;
  }
  .caption {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-hand);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-meta);
    line-height: var(--font-leading-title);
    color: var(--ink-2);
    text-align: center;
  }
</style>
