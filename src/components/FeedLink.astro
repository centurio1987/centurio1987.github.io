---
// 눈에 보이는 RSS 구독 링크 (KAN-047).
//
// 목록 페이지(전체 글 · 카테고리)의 제목 옆에 선다. 전용 컴포넌트로 뺀 이유는
// 자리가 늘어날 때마다 아이콘·문구·툴팁이 조금씩 갈라지기 때문이다.
import { FEED_NOTE } from "../lib/feed";

interface Props {
  href: string;
  /** 어떤 피드인지 — "기획 글" 처럼 대상을 적으면 aria-label 이 구체적이 된다. */
  label?: string;
}
const { href, label } = Astro.props;
const aria = label ? `${label} RSS 구독` : "RSS 구독";
---

<a class="feed-link" href={href} aria-label={aria} title={FEED_NOTE}>
  {/* 표준 RSS 마크(왼쪽 아래 점 + 두 호). currentColor 라 링크 색을 그대로 따른다. */}
  <svg
    class="feed-icon"
    viewBox="0 0 16 16"
    width="13"
    height="13"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="3.2" cy="12.8" r="1.9" fill="currentColor"></circle>
    <path
      d="M2 7.4a6.6 6.6 0 0 1 6.6 6.6M2 2.6A11.4 11.4 0 0 1 13.4 14"
      fill="none"
      stroke="currentColor"
      stroke-width="2.1"
      stroke-linecap="round"></path>
  </svg>
  <span>RSS</span>
</a>

<style>
  .feed-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.5px;
    color: var(--ink-3);
    border: var(--stroke-hair) solid var(--border);
    border-radius: var(--btn-radius);
    /* 좌우가 다른 건 아이콘(왼쪽)이 글자보다 시각 무게가 가벼워서다 — 스냅 뒤에도
       그 비대칭을 지킨다(11·9 → 10·8). */
    padding: var(--space-4) var(--space-10) var(--space-4) var(--space-8);
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .feed-link:hover {
    color: var(--accent);
    border-color: var(--accent-tint);
  }
  .feed-icon {
    /* 기준선 맞춤은 캡슐의 `align-items: center` 가 한다. 예전엔 여기 `margin-top: -1px`
       가 하나 더 얹혀 있었는데 §9 스케일 밖이라 걷었다 — 실측으로 잃는 것이 없다:
       아이콘 중심이 글자 캡 높이 중심에서 0.5px 위였던 것이 0.5px 아래가 될 뿐이다.
       1px 을 다시 적는 대신 이 줄을 읽어라. */
    display: block;
  }
</style>
