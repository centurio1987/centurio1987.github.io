---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class={className}
  width="100%"
  height="10"
  viewBox="0 0 540 12"
  preserveAspectRatio="none"
  aria-hidden="true"
  style="display:block;"
>
  <path
    d="M2 7 Q 30 1, 60 7 T 120 7 T 180 6 T 240 7 T 300 6 T 360 7 T 420 6 T 480 7 T 538 6"
    fill="none"
    stroke="var(--ink)"
    stroke-width="1.6"
    stroke-linecap="round"
    opacity="0.5"
    data-reveal="draw"></path>
</svg>
