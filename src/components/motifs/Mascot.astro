---
interface Props {
  size?: number;
  class?: string;
}
const { size = 80, class: className = "" } = Astro.props;
---

<svg
  class={`mascot ${className}`}
  width={size}
  height={(size * 44) / 60}
  viewBox="0 0 60 44"
  fill="none"
  aria-hidden="true"
>
  <g
    stroke="var(--ink)"
    stroke-width="1.6"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path
      d="M14 40 Q10 22 18 14 Q28 4 40 12 Q50 20 44 32 Q40 40 28 40 Z"
      fill="var(--signature)"></path>
    <circle cx="24" cy="22" r="1.6" fill="var(--ink)"></circle>
    <circle cx="34" cy="22" r="1.6" fill="var(--ink)"></circle>
    <path d="M25 28 Q29 31 33 28"></path>
  </g>
</svg>

<style>
  .mascot {
    transform-origin: bottom center;
    animation: tony-wobble 3.2s var(--ease) infinite;
  }
  @keyframes tony-wobble {
    0%,
    100% {
      transform: rotate(-2deg) translateY(0);
    }
    50% {
      transform: rotate(2deg) translateY(-2px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mascot {
      animation: none;
    }
  }
</style>
