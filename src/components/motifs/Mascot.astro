---
/**
 * 마스코트 '토니' SVG.
 *
 * 색은 전부 `--tony-*` 다 (KAN-072 배치7). **UI 팔레트와 독립인 캐릭터 고유색**이라
 * `--cat-*`·`--pop`·`--surface-hi` 와 값이 같은 셋도 그쪽을 가리키지 않는다 — 사유는
 * `src/styles/tokens.css` 의 「마스코트 '토니' 팔레트」 주석과 DESIGN_CONCEPT.md §7.
 * **새 색을 리터럴로 적지 마라.** 역할이 늘면 토큰을 먼저 세우고 문서 표에 한 줄 더한다.
 */
interface Props {
  size?: number;
  companion?: boolean;
  class?: string;
}
const { size = 96, companion = true, class: className = "" } = Astro.props;
const h = Math.round((size * 152) / 168);
---

<svg
  class={`mascot ${className}`}
  width={size}
  height={h}
  viewBox="0 0 168 152"
  fill="none"
  role="img"
  aria-label="빵관 토니 마스코트"
>
  <g
    stroke="var(--tony-ink, #1c1b18)"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <!-- ground shadow -->
    <ellipse cx="92" cy="144" rx="62" ry="6" fill="var(--tony-ink, #1c1b18)" opacity="0.08" stroke="none"></ellipse>

    <!-- arms (behind body) -->
    <g fill="var(--tony-body, #f4a6be)">
      <ellipse cx="146" cy="72" rx="9" ry="19" transform="rotate(28 146 72)"></ellipse>
      <circle cx="156" cy="56" r="11"></circle>
      <ellipse cx="52" cy="108" rx="8" ry="15" transform="rotate(-22 52 108)"></ellipse>
      <circle cx="46" cy="118" r="8"></circle>
    </g>

    <!-- feet (behind body) -->
    <g fill="var(--tony-body, #f4a6be)">
      <ellipse cx="82" cy="136" rx="12" ry="8"></ellipse>
      <ellipse cx="114" cy="136" rx="12" ry="8"></ellipse>
    </g>

    <!-- body -->
    <path
      d="M98 38 C 128 38, 152 54, 152 84 C 152 112, 132 134, 98 134 C 64 134, 44 112, 44 84 C 44 54, 68 38, 98 38 Z"
      fill="var(--tony-body, #f4a6be)"></path>

    <!-- ears -->
    <g>
      <ellipse cx="82" cy="26" rx="9" ry="22" transform="rotate(-10 82 26)" fill="var(--tony-body, #f4a6be)"></ellipse>
      <ellipse cx="114" cy="24" rx="9" ry="22" transform="rotate(10 114 24)" fill="var(--tony-body, #f4a6be)"></ellipse>
      <ellipse cx="82" cy="28" rx="4.2" ry="13" transform="rotate(-10 82 28)" fill="var(--tony-body-deep, #e07c9c)" stroke="none"></ellipse>
      <ellipse cx="114" cy="26" rx="4.2" ry="13" transform="rotate(10 114 26)" fill="var(--tony-body-deep, #e07c9c)" stroke="none"></ellipse>
    </g>

    <!-- light plush front (belly/chest) -->
    <ellipse cx="98" cy="96" rx="33" ry="37" fill="var(--tony-plush, #fffdf8)" stroke="none"></ellipse>

    <!-- braid crown (빵) — mustard pop -->
    <g>
      <g fill="var(--tony-bread-deep, #be8a2c)" stroke="none" opacity="0.9">
        <ellipse cx="70" cy="61" rx="11" ry="9"></ellipse>
        <ellipse cx="84" cy="56" rx="11" ry="9"></ellipse>
        <ellipse cx="98" cy="54" rx="11" ry="9"></ellipse>
        <ellipse cx="112" cy="56" rx="11" ry="9"></ellipse>
        <ellipse cx="126" cy="61" rx="11" ry="9"></ellipse>
      </g>
      <g fill="var(--tony-bread, #d8a33f)">
        <ellipse cx="68" cy="57" rx="12" ry="10" transform="rotate(24 68 57)"></ellipse>
        <ellipse cx="82" cy="51" rx="12" ry="10" transform="rotate(-24 82 51)"></ellipse>
        <ellipse cx="96" cy="49" rx="12" ry="10" transform="rotate(24 96 49)"></ellipse>
        <ellipse cx="110" cy="51" rx="12" ry="10" transform="rotate(-24 110 51)"></ellipse>
        <ellipse cx="124" cy="57" rx="12" ry="10" transform="rotate(24 124 57)"></ellipse>
      </g>
      <g stroke="var(--tony-bread-deep, #be8a2c)" stroke-width="1.6" opacity="0.85">
        <path d="M64 53 L72 61"></path>
        <path d="M78 47 L86 55"></path>
        <path d="M92 45 L100 53"></path>
        <path d="M106 47 L114 55"></path>
        <path d="M120 53 L128 61"></path>
      </g>
    </g>

    <!-- blush -->
    <ellipse cx="71" cy="99" rx="8" ry="5" fill="var(--tony-blush, #dc6e92)" opacity="0.5" stroke="none"></ellipse>
    <ellipse cx="125" cy="99" rx="8" ry="5" fill="var(--tony-blush, #dc6e92)" opacity="0.5" stroke="none"></ellipse>

    <!-- eyes -->
    <ellipse cx="84" cy="83" rx="4.6" ry="5.6" fill="var(--tony-ink, #1c1b18)" stroke="none"></ellipse>
    <ellipse cx="112" cy="83" rx="4.6" ry="5.6" fill="var(--tony-ink, #1c1b18)" stroke="none"></ellipse>
    <circle cx="85.6" cy="81" r="1.4" fill="var(--tony-glint, #ffffff)" stroke="none"></circle>
    <circle cx="113.6" cy="81" r="1.4" fill="var(--tony-glint, #ffffff)" stroke="none"></circle>

    <!-- nose + mouth + tongue -->
    <path d="M93 90 Q98 88 103 90 Q101 95 98 95 Q95 95 93 90 Z" fill="var(--tony-nose, #5a3b2e)" stroke="none"></path>
    <path d="M98 95 L98 97" stroke-width="1.8"></path>
    <path d="M91 98 Q98 101 105 98 Q105 105 98 105 Q91 105 91 98 Z" fill="var(--tony-mouth, #7a4a38)" stroke="var(--tony-ink, #1c1b18)" stroke-width="1.8"></path>
    <ellipse cx="98" cy="103" rx="3.4" ry="2.4" fill="var(--tony-tongue, #e2897a)" stroke="none"></ellipse>

    <!-- companion (작은 친구) -->
    {companion && (
      <g>
        <path d="M38 101 C 50 90, 50 76, 42 78 C 37 79, 39 88, 45 88" stroke="var(--tony-ink, #1c1b18)" stroke-width="2.2" fill="none"></path>
        <path d="M19 100 L16 89 L25 97 Z" fill="var(--tony-buddy, #3e6b4f)" stroke-width="2"></path>
        <path d="M37 100 L40 89 L31 97 Z" fill="var(--tony-buddy, #3e6b4f)" stroke-width="2"></path>
        <ellipse cx="20" cy="133" rx="5" ry="4" fill="var(--tony-buddy, #3e6b4f)" stroke-width="2"></ellipse>
        <ellipse cx="36" cy="133" rx="5" ry="4" fill="var(--tony-buddy, #3e6b4f)" stroke-width="2"></ellipse>
        <circle cx="28" cy="116" r="19" fill="var(--tony-buddy, #3e6b4f)"></circle>
        <ellipse cx="28" cy="121" rx="10" ry="11" fill="var(--tony-buddy-belly, #8cc2a0)" stroke="none"></ellipse>
        <g stroke="var(--tony-buddy-mark, #2f5740)" stroke-width="1.4" opacity="0.7">
          <path d="M15 110 l3 0"></path>
          <path d="M40 110 l3 0"></path>
          <path d="M17 124 l3 0"></path>
          <path d="M38 124 l3 0"></path>
        </g>
        <circle cx="28" cy="114" r="8" fill="var(--tony-glint, #ffffff)"></circle>
        <circle cx="29" cy="115" r="3.8" fill="var(--tony-ink, #1c1b18)" stroke="none"></circle>
        <circle cx="30.4" cy="113.2" r="1.3" fill="var(--tony-glint, #ffffff)" stroke="none"></circle>
        <path d="M22 123 Q28 127 34 123" stroke-width="1.8"></path>
      </g>
    )}
  </g>
</svg>

<style>
  .mascot {
    transform-origin: bottom center;
    animation: tony-wobble 3.4s var(--ease) infinite;
    overflow: visible;
  }
  @keyframes tony-wobble {
    0%,
    100% {
      transform: rotate(-1.5deg) translateY(0);
    }
    50% {
      transform: rotate(1.5deg) translateY(-2px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mascot {
      animation: none;
    }
  }
</style>
