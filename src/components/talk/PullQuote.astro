---
import { TALK } from "../../lib/talk";

/**
 * 핵심 인용구 하이라이트 (디자인 1a pull quote 패턴)
 * MDX 사용 예:
 *   <PullQuote>빵은 발효를 기다리는 시간에 부풀어요.</PullQuote>
 */
interface Props {
  /** 출처 표기 (기본: 빵토 교수님) */
  by?: string;
}
const { by = TALK.interviewee.name } = Astro.props;
---

<figure class="pull-quote">
  <blockquote class="pq-text">“<slot />”</blockquote>
  <figcaption class="pq-by">— {by}</figcaption>
</figure>

<style>
  .pull-quote {
    margin: var(--space-32) 0;
    background: var(--accent);
    border-radius: var(--radius-lg);
    padding: var(--space-32) var(--space-48);
    text-align: center;
  }
  .pq-text {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: var(--font-leading-sub);
    color: var(--paper);
    /* -0.3px 이던 자리다. 28px 에서 −0.0107em 이라 tight(−0.02em)까지 0.0093 ·
       normal(선언 안 함)까지 0.0107 로 **거리 차가 0.0014em 밖에 안 난다** — 그래서
       거리가 아니라 뜻이 갈랐다. §5 는 tight 을 「큰 제목」에 배정했고 이 자리가
       28px 디스플레이 인용구다 (KAN-080 S16). */
    letter-spacing: var(--font-track-tight);
    margin: 0;
    border: none;
    padding: 0;
    background: none;
  }
  .pq-text :global(p) {
    display: inline;
    margin: 0;
  }
  .pq-by {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    /* 1px 이던 자리다. 11px 에서 0.0909em 이라 거리로는 wide 인데, 문구가
       `— 빵토 교수님`(TALK.interviewee.name)이라 한글이 들어 한 단 아래다(§5). */
    letter-spacing: var(--font-track-label);
    color: var(--accent-tint);
    margin-top: var(--space-16);
  }
  @media (max-width: 560px) {
    .pull-quote {
      padding: var(--space-24);
    }
    .pq-text {
      font-size: var(--text-h3);
    }
  }
</style>
