---
import Logo from "./Logo.astro";
import { HOME_URL, POSTS_URL, GRAPH_URL } from "../lib/urls";
const path = Astro.url.pathname;
const isPosts = path.startsWith("/posts") || path.startsWith("/categories");
---

<header class="site-header">
  <div class="header-inner">
    <Logo size={24} />
    <nav class="nav" aria-label="주요">
      <a href={HOME_URL} class:list={["nav-link", { active: path === "/" }]}>홈</a>
      <a href={POSTS_URL} class:list={["nav-link", { active: isPosts }]}>블로그</a>
      <a href={GRAPH_URL} class:list={["nav-link", { active: path.startsWith("/graph") }]}>글지도</a>
      <a
        href="https://github.com/centurio1987"
        class="nav-link nav-link-latin"
        target="_blank"
        rel="noopener">GitHub</a
      >
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--stroke-hair) solid var(--border);
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    backdrop-filter: saturate(1.1) blur(6px);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .header-inner {
    /* 셸은 지면 폭을 따라간다 (KAN-068). 폴백이 읽는 판 720px 이다. */
    max-width: var(--shell-max, var(--content-max));
    margin: 0 auto;
    padding: var(--space-14) var(--page-pad);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  /* 한글 링크 셋은 순한글이라 `--font-label-ko` 로 배정하고(공백이 Space Mono 에서 오는 것을
     막는다), 라틴 하나만 아래 `.nav-link-latin` 이 mono 로 되돌린다. 굵기 700 은 한글·라틴
     공통이다 — 400 이면 nav 가 본문 산문과 같은 굵기로 읽힌다(KAN-081). */
  .nav {
    display: flex;
    gap: var(--space-24);
    font-family: var(--font-label-ko);
    font-size: var(--text-meta);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--font-track-label-ko);
  }
  .nav-link-latin {
    font-family: var(--font-mono);
    letter-spacing: var(--font-track-label);
  }
  .nav-link {
    color: var(--ink-2);
    transition: color var(--dur) var(--ease);
    padding-bottom: var(--space-2);
  }
  .nav-link:hover {
    color: var(--ink);
  }
  .nav-link.active {
    color: var(--ink);
    border-bottom: var(--stroke-bold) solid var(--accent);
  }
</style>
