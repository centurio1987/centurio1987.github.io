---
import type { MarkdownHeading } from "astro";

/**
 * PostToc — 화면 오른쪽에 떠 있는 접힘/펼침 목차 레일 (KAN-050).
 *
 * ── 어디서 오는 데이터인가
 * `render(post)` 가 돌려주는 headings 를 그대로 받는다. 이 slug 는 Astro 의
 * rehypeHeadingIds 가 **DOM 에 실제로 박은 그 id 를 push 한 값**이라(md·mdx 공통)
 * 링크와 앵커가 어긋날 수 없다 — 같은 제목이 두 번 나올 때의 `-1` 접미사까지 따라온다.
 * 덕분에 본문 파일에는 손을 대지 않는다.
 *
 * ── 무JS 로 완결된다
 * 서버가 그린 평범한 앵커 링크가 전부고, 점프는 global.css 의
 * `html { scroll-behavior: smooth }` + 헤딩의 scroll-margin-top(PostLayout)이 처리한다.
 * 펼침조차 CSS :hover / :focus-within 이라 JS 없이 동작한다. tocSpy.ts 가 얹는 건
 * "지금 읽는 절" 하이라이트, tocFloat.ts 가 얹는 건 hover 없는 입력(터치) 대응뿐이다.
 *
 * ── 접힘이 기본이다
 * 평소엔 눈금(tick)만 세로로 늘어서 글의 뼈대와 현재 위치를 실루엣으로만 보여주고,
 * 레일 근처에 포인터가 오면 라벨까지 펼친다. 펼친 상태는 **오버레이**라 본문 칼럼 폭에
 * 자리를 구걸하지 않는다 — 그래서 우측 여백에 240px 을 상시 확보해야 했던 초안(1320px)
 * 대신 880px 부터 켤 수 있다. 세로로는 화면 절반쯤만 쓰고 수직 중앙에 정렬한다.
 *
 * ── 깊이는 상태마다 다른 신호로 표현한다
 * 접힘: 눈금 **길이**(h2 20px / h3 9px)와 농도. 글자가 없으니 이게 유일한 구조 신호다.
 * 펼침: 눈금을 아예 지우고 **글자 자체**가 진다 — 크기·굵기·색에 더해, 라벨 폭을 줄여
 * 만드는 들여쓰기(오른쪽 정렬이라 폭을 줄이면 왼쪽 끝이 밀려 들어간다)와 h2 앞의
 * 여백으로 절을 묶는다.
 */
interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;

// h2·h3 만. h1 은 글 제목이라 본문에 없고, h4 는 전 글 통틀어 1개뿐이라 소음이다.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);

// 항목 1개짜리 목차는 정보가 0이다. 2개부터 점프 가치가 생긴다.
const show = items.length >= 2;
---

{
  show && (
    <nav class="post-toc" aria-label="이 글의 목차">
      <div class="toc-panel" data-toc-scroll>
        <div class="toc-head">목차 · CONTENTS</div>
        <ul class="toc-list">
          {items.map((h) => (
            <li>
              <a href={`#${h.slug}`} data-slug={h.slug} data-depth={h.depth} title={h.text}>
                <span class="toc-label">{h.text}</span>
                <span class="toc-tick" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

<script>
  import { initTocSpy } from "../lib/motion/tocSpy";
  import { initTocFloat } from "../lib/motion/tocFloat";
  // ClientRouter(View Transitions)가 켜져 있어 모듈 스크립트는 페이지마다 재실행되지
  // 않는다 — 두 함수 모두 내부에서 astro:page-load 재바인딩을 건다.
  initTocSpy();
  initTocFloat();
</script>

<style>
  /* 기본은 숨김. 접힘 상태가 본문을 침범하지 않는 폭에서만 켠다. */
  .post-toc {
    display: none;
  }

  /* 880px 근거: 접힘 상태의 히트 영역(패널 48 + 좌측 여백 16 + 우측 6 = 70px)이
     본문 720px 칼럼을 침범하지 않는 최소 폭 = 720 + 70×2 = 860. 여유를 둬 880.
     이보다 낮추면 접힘 눈금이 본문 오른쪽 끝 글자 위에 얹힌다.
     (펼침이 본문을 덮는 건 의도된 설계다 — 오버레이니까.) */
  @media (min-width: 880px) {
    .post-toc {
      display: block;
      position: fixed;
      right: 6px;
      top: 50%;
      transform: translateY(-50%);
      /* 헤더(z-index:10) 아래. 레일은 세로 중앙이라 겹칠 일이 거의 없지만,
         겹치면 헤더가 이겨야 한다. */
      z-index: 9;
      /* 왼쪽 여백이 곧 "근처"의 크기다 — 포인터가 이만큼만 다가와도 펼쳐진다. */
      padding: var(--space-8) 0 var(--space-8) var(--space-16);
    }
  }

  /* 인쇄물에서 fixed 레일은 본문을 덮거나 첫 장에 유령처럼 찍힌다. */
  @media print {
    .post-toc {
      display: none;
    }
  }

  .post-toc {
    /* 튜닝 손잡이. 접힘/펼침의 차이는 결국 이 값들이다. */
    --toc-w: 48px;
    /* 펼침 폭 = 라벨 + 좌우 패딩 + 보더 + 스크롤바 여유. 라벨을 넓힐 땐 둘을 같이
       올려야 왼쪽 글자가 overflow 로 잘리지 않는다(펼침도 flex-end 라 여유가 왼쪽에
       생긴다). */
    --toc-w-open: 320px;
    --toc-label-w: 272px;
    /* h3 들여쓰기. 라벨이 오른쪽 정렬이라 폭을 줄이면 왼쪽 끝이 그만큼 밀려 들어간다. */
    --toc-indent: 20px;
    --toc-pitch: 15px;
    --toc-pitch-open: 26px;
    /* "전체 높이가 아니라 절반쯤" — 넘치면 레일 안에서만 스크롤된다. */
    --toc-max-h: 52vh;
  }

  .toc-panel {
    box-sizing: border-box;
    width: var(--toc-w);
    max-height: var(--toc-max-h);
    padding: var(--space-10) var(--space-14);
    border: var(--stroke-hair) solid transparent;
    border-radius: var(--radius-md);
    background: transparent;
    /* 접힘: 넘치는 라벨을 왼쪽에서 잘라낸다. 클리핑 경계는 패딩 박스라 눈금이
       패딩 위로 조금 넘쳐도 잘리지 않는다(활성 눈금이 그렇다). */
    overflow: hidden;
    scrollbar-width: thin;
    transition:
      width var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  /* 펼침 — hover(마우스) · focus-within(키보드) · .is-open(터치, tocFloat.ts) */
  .post-toc:hover,
  .post-toc:focus-within,
  .post-toc.is-open {
    --toc-pitch: var(--toc-pitch-open);
  }
  .post-toc:hover .toc-panel,
  .post-toc:focus-within .toc-panel,
  .post-toc.is-open .toc-panel {
    width: var(--toc-w-open);
    overflow: hidden auto;
    overscroll-behavior: contain;
    background: var(--surface);
    border-color: var(--border);
    box-shadow: 0 10px 30px rgba(32, 38, 74, 0.14);
  }

  .toc-head {
    font-family: var(--font-mono);
    font-size: var(--text-nano);
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
    text-align: right;
    /* 접힘일 땐 세로 자리도 차지하지 않는다 — 눈금 리듬을 깨지 않으려고. */
    height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      height var(--dur) var(--ease),
      opacity var(--dur) var(--ease),
      margin-bottom var(--dur) var(--ease);
  }
  .post-toc:hover .toc-head,
  .post-toc:focus-within .toc-head,
  .post-toc.is-open .toc-head {
    height: 15px;
    margin-bottom: var(--space-8);
    opacity: 1;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* 오른쪽 정렬이 기준선이다. 접힘에선 눈금이, 펼침에선 라벨이 이 선에 붙는다. */
  .toc-list a {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-10);
    height: var(--toc-pitch);
    transition:
      height var(--dur) var(--ease),
      margin-top var(--dur) var(--ease);
  }

  /* ── 눈금: 접힘 상태의 유일한 정보 ── */
  .toc-tick {
    flex: 0 0 auto;
    display: block;
    width: 20px;
    height: 2px;
    border-radius: var(--radius-xs);
    background: var(--ink-3);
    /* 크림 배경에서 묻히지 않을 만큼만 진하게. */
    opacity: 0.72;
    transition:
      width var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
  }
  .toc-list a[data-depth="3"] .toc-tick {
    width: 9px;
    opacity: 0.45;
  }
  /* 접힘에서 현재 위치를 알리는 신호 — 색과 길이를 함께 바꾼다. 색만 바꾸면
     주변시에서 안 읽히고, 길이만 바꾸면 흑백 화면에서 약하다. */
  .toc-list a.is-active .toc-tick {
    background: var(--accent);
    opacity: 1;
    width: 28px;
  }
  .toc-list a[data-depth="3"].is-active .toc-tick {
    width: 16px;
  }

  /* 펼치면 눈금은 사라진다 — 깊이는 이제 글자가 진다. 오른쪽에 막대가 남으면
     라벨과 신호가 이중으로 겹쳐 목록이 시끄러워진다.
     선택자에 [data-depth] 를 끼우는 건 장식이 아니라 명시도 때문이다. 위의 깊이별·
     활성 눈금 규칙이 (0,3,1)이라 그냥 `.post-toc:hover .toc-tick`(0,2,0)으로 쓰면
     h3 와 활성 항목의 막대만 살아남는다. */
  .post-toc:hover .toc-list a[data-depth] .toc-tick,
  .post-toc:focus-within .toc-list a[data-depth] .toc-tick,
  .post-toc.is-open .toc-list a[data-depth] .toc-tick {
    width: 0;
    opacity: 0;
  }
  .post-toc:hover .toc-list a,
  .post-toc:focus-within .toc-list a,
  .post-toc.is-open .toc-list a {
    gap: 0;
  }

  /* ── 라벨: 펼침 상태의 전부 ── */
  .toc-label {
    flex: 0 0 auto;
    width: var(--toc-label-w);
    /* 한 줄 고정 — 줄바꿈을 허용하면 항목마다 높이가 달라져 접힘 상태의 눈금 간격이
       들쭉날쭉해진다. 잘린 전문은 a[title] 이 보관한다. */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--text-meta);
    line-height: 1.4;
    color: var(--ink-2);
    opacity: 0;
    translate: 6px 0;
    transition:
      opacity var(--dur) var(--ease),
      translate var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .post-toc:hover .toc-label,
  .post-toc:focus-within .toc-label,
  .post-toc.is-open .toc-label {
    opacity: 1;
    translate: 0 0;
    /* 폭이 벌어지기 시작한 뒤에 글자가 들어와야 '펼쳐진다'로 읽힌다. */
    transition-delay: 60ms;
  }

  /* h2 = 절의 머리. 굵고 진하고, 앞에 숨 쉴 자리를 둬 아래 h3 들을 묶는다.
     (여백은 펼침에서만 준다 — 접힘의 눈금 리듬은 균일해야 한다.) */
  .toc-list a[data-depth="2"] .toc-label {
    font-weight: 600;
    color: var(--ink);
  }
  .post-toc:hover .toc-list a[data-depth="2"],
  .post-toc:focus-within .toc-list a[data-depth="2"],
  .post-toc.is-open .toc-list a[data-depth="2"] {
    margin-top: var(--space-8);
  }
  .post-toc:hover .toc-list li:first-child a,
  .post-toc:focus-within .toc-list li:first-child a,
  .post-toc.is-open .toc-list li:first-child a {
    margin-top: 0;
  }

  /* h3 = 절 안의 갈래. 한 단 들여쓰고 작고 옅게. */
  .toc-list a[data-depth="3"] .toc-label {
    width: calc(var(--toc-label-w) - var(--toc-indent));
    font-size: var(--text-label);
    font-weight: 400;
    color: var(--ink-3);
  }

  .toc-list a:hover .toc-label {
    color: var(--ink);
  }
  .toc-list a:hover .toc-tick {
    background: var(--ink);
    opacity: 1;
  }
  .toc-list a:focus-visible {
    outline: var(--stroke-bold) solid var(--accent);
    outline-offset: 1px;
    border-radius: var(--radius-xs);
  }
  .toc-list a.is-active .toc-label {
    color: var(--accent);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-panel,
    .toc-head,
    .toc-label,
    .toc-tick,
    .toc-list a {
      transition: none;
    }
  }
</style>
