---
import { getCategory } from "../lib/categories";
interface Props {
  category: string;
  asLink?: boolean;
}
const { category, asLink = false } = Astro.props;
const meta = getCategory(category);
const Tag = asLink ? "a" : "span";
const href = asLink ? `/categories/${meta.slug}` : undefined;
---

<Tag
  class="badge"
  href={href}
  style={`--cat:${meta.color}`}
>
  {meta.label}
</Tag>

<style>
  .badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    padding: 4px 10px;
    border-radius: 999px;
    color: color-mix(in srgb, var(--cat) 78%, var(--ink));
    background: color-mix(in srgb, var(--cat) 14%, var(--surface));
    border: 1px solid var(--ink);
  }
  a.badge {
    transition:
      background var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  a.badge:hover {
    background: color-mix(in srgb, var(--cat) 24%, var(--surface));
    transform: translateY(-1px);
  }
</style>
