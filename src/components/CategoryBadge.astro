---
import { getCategory } from "../lib/categories";
import { categoryUrl } from "../lib/urls";
interface Props {
  category: string;
  asLink?: boolean;
}
const { category, asLink = false } = Astro.props;
const meta = getCategory(category);
const Tag = asLink ? "a" : "span";
const href = asLink ? categoryUrl(meta.slug) : undefined;
---

<Tag
  class="badge"
  href={href}
  style={`--cat:${meta.color}`}
>
  {meta.label}
</Tag>

<style>
  .badge {
    display: inline-block;
    font-size: var(--text-label);
    font-weight: var(--font-weight-medium);
    line-height: var(--font-leading-flat);
    padding: var(--space-4) var(--space-10);
    border-radius: var(--btn-radius);
    color: color-mix(in srgb, var(--cat) 78%, var(--ink));
    background: color-mix(in srgb, var(--cat) 14%, var(--surface));
    border: var(--stroke-hair) solid var(--ink);
  }
  a.badge {
    transition:
      background var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  a.badge:hover {
    background: color-mix(in srgb, var(--cat) 24%, var(--surface));
    transform: translateY(-1px);
  }
</style>
