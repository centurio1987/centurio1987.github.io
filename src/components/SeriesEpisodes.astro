---
import fs from "node:fs";
import path from "node:path";
import type { CollectionEntry } from "astro:content";
import { getSeriesPosts, episodeNumber } from "../lib/seriesNav";
import { postUrl } from "../lib/urls";

/**
 * 지난 에피소드 카드 목록 (디자인: 폭신 대담 — episodes 카드 그리드 패턴)
 * 같은 series의 모든 글을 EP 순서로 카드로 보여준다. 시리즈가 없으면 렌더링하지 않는다.
 */
interface Props {
  post: CollectionEntry<"posts">;
  allPosts: CollectionEntry<"posts">[];
  title?: string;
}
const { post, allPosts, title } = Astro.props;
const episodes = getSeriesPosts(post, allPosts);

const thumbOf = (p: CollectionEntry<"posts">): string | null => {
  const slug = p.id.replace(/\.(md|mdx)$/, "");
  const hero = path.join(process.cwd(), "public", "images", slug, "hero.webp");
  return fs.existsSync(hero) ? `/images/${slug}/hero.webp` : null;
};
---

{
  episodes.length > 1 && (
    <section class="episodes" aria-label="시리즈 에피소드">
      <h2 class="episodes-title">{title ?? `${post.data.series} 다시보기`}</h2>
      <div class="episodes-grid">
        {episodes.map((ep, i) => {
          const n = String(episodeNumber(ep, episodes)).padStart(2, "0");
          const thumb = thumbOf(ep);
          const isCurrent = ep.id === post.id;
          return (
            <a
              href={postUrl(ep.id)}
              class:list={["ep-card", { "is-current": isCurrent }]}
              aria-current={isCurrent ? "page" : undefined}
              data-reveal="up"
              style={`--reveal-i:${i}`}
            >
              {thumb ? (
                <img class="ep-thumb" src={thumb} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="ep-thumb ep-thumb--hatch" aria-hidden="true" />
              )}
              <span class="ep-body">
                <span class="ep-num">
                  EP.{n}
                  {isCurrent && <span class="ep-now">지금 읽는 중</span>}
                </span>
                <span class="ep-title">{ep.data.title}</span>
              </span>
            </a>
          );
        })}
      </div>
    </section>
  )
}

<style>
  .episodes {
    margin-top: var(--space-32);
    background: var(--cream);
    border-radius: var(--radius-lg);
    padding: var(--space-32);
  }
  .episodes-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-h3);
    color: var(--ink);
    margin: 0 0 var(--space-16);
  }
  .episodes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-16);
  }
  .ep-card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    transition: translate var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .ep-card:hover {
    translate: 0 -2px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
  }
  .ep-card.is-current {
    outline: var(--stroke-bold) solid var(--accent);
    outline-offset: -2px;
  }
  .ep-thumb {
    display: block;
    width: 100%;
    height: 90px;
    object-fit: cover;
  }
  .ep-thumb--hatch {
    background: var(--hatch);
  }
  .ep-body {
    padding: var(--space-14) var(--space-16) var(--space-16);
  }
  .ep-num {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--accent);
  }
  .ep-now {
    font-size: var(--text-nano);
    background: var(--accent);
    color: var(--paper);
    border-radius: var(--btn-radius);
    padding: var(--space-2) var(--space-8);
  }
  .ep-title {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-small);
    line-height: 1.4;
    color: var(--ink);
    margin-top: var(--space-6);
  }
  @media (max-width: 720px) {
    .episodes-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .episodes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
