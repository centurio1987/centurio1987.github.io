---
const path = Astro.url.pathname;

const navItems = [
  {
    title: "공통",
    items: [
      { name: "이력서", href: "/career/resume" },
      { name: "자기소개서", href: "/career/cover-letter" },
    ],
  },
  {
    title: "CTO",
    items: [
      { name: "경력 기술서", href: "/career/cto/experience" },
      { name: "포트폴리오", href: "/career/cto/portfolio" },
      { name: "가치관", href: "/career/cto/values" },
    ],
  },
  {
    title: "Node.js Engineer",
    items: [
      { name: "경력 기술서", href: "/career/nodejs-engineer/experience" },
      { name: "포트폴리오", href: "/career/nodejs-engineer/portfolio" },
      { name: "가치관", href: "/career/nodejs-engineer/values" },
    ],
  },
  {
    title: "Product Engineer",
    items: [
      { name: "경력 기술서", href: "/career/product-engineer/experience" },
      { name: "포트폴리오", href: "/career/product-engineer/portfolio" },
      { name: "가치관", href: "/career/product-engineer/values" },
    ],
  },
  {
    title: "PO",
    items: [
      { name: "경력 기술서", href: "/career/po/experience" },
      { name: "포트폴리오", href: "/career/po/portfolio" },
      { name: "가치관", href: "/career/po/values" },
    ],
  },
];
---

<nav class="career-nav" aria-label="커리어 네비게이션">
  {
    navItems.map((group) => (
      <div class="nav-group">
        <h3 class="group-title">{group.title}</h3>
        <ul class="nav-list">
          {group.items.map((item) => {
            const isActive =
              path === item.href || path === item.href + "/";
            return (
              <li>
                <a
                  href={item.href}
                  class:list={["nav-link", { active: isActive }]}
                >
                  {item.name}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</nav>

<style>
  .career-nav {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 16px 0;
  }
  .nav-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .group-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }
  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .nav-link {
    display: block;
    padding: 6px 12px;
    margin-left: -12px;
    border-radius: 8px;
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: all var(--dur) var(--ease);
  }
  .nav-link:hover {
    color: var(--ink);
    background: var(--subtle);
  }
  .nav-link.active {
    color: var(--ink);
    font-weight: 700;
    background: var(--surface);
    border-left: 2px solid var(--signature);
    border-radius: 0 8px 8px 0;
  }
</style>
