---
import Sparkle from "./motifs/Sparkle.astro";
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<a href="/" class="logo" aria-label="빵관 토니 — 홈" style={`--logo-size:${size}px`}>
  <span class="wordmark">빵관 토니</span>
  <Sparkle size={Math.round(size * 0.7)} class="logo-sparkle" />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--ink);
  }
  .wordmark {
    font-weight: 800;
    font-size: var(--logo-size);
    letter-spacing: -0.03em;
  }
  .logo-sparkle {
    transition: transform var(--dur) var(--ease);
  }
  .logo:hover .logo-sparkle {
    transform: rotate(90deg) scale(1.1);
  }
</style>
